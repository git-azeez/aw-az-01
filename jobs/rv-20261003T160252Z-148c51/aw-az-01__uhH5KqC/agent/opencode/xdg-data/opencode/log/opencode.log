timestamp=2026-10-03T16:29:39.907Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json, time\n\necs = boto3.client('ecs', endpoint_url='http://aws:4566', region_name='us-east-1')\niam = boto3.client('iam', endpoint_url='http://aws:4566', region_name='us-east-1')\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\n\n# Create SG for ECS\nsg = ec2.create_security_group(GroupName='test-ecs-task-sg', Description='test', VpcId='vpc-default-us-east-1')\nsg_id = sg['GroupId']\n\n# Create IAM role\ntry:\n    role = iam.create_role(RoleName='test-ecs-exec3', AssumeRolePolicyDocument=json.dumps({\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}]\n    }))\n    role_arn = role['Role']['Arn']\nexcept:\n    role_arn = 'arn:aws:iam::000000000000:role/test-ecs-exec3'\n\n# Create cluster\necs.create_cluster(clusterName='test-cluster3')\n\n# Create task definition\ntask_def = ecs.register_task_definition(\n    family='test-task3',\n    requiresCompatibilities=['FARGATE'],\n    networkMode='awsvpc',\n    cpu='256',\n    memory='512',\n    executionRoleArn=role_arn,\n    containerDefinitions=[{\n        'name': 'api',\n        'image': 'clearledger/api:1.0.0',\n        'portMappings': [{'containerPort': 8080, 'protocol': 'tcp'}],\n        'environment': [\n            {'name': 'PORT', 'value': '8080'},\n            {'name': 'AWS_REGION', 'value': 'us-east-1'},\n            {'name': 'AWS_ACCESS_KEY_ID', 'value': 'test'},\n            {'name': 'AWS_SECRET_ACCESS_KEY', 'value': 'test'},\n            {'name': 'AWS_ENDPOINT_URL', 'value': 'http://aws:4566'},\n        ],\n    }]\n)\ntask_arn = task_def['taskDefinition']['taskDefinitionArn']\n\n# Create service with SG\nsvc = ecs.create_service(\n    cluster='test-cluster3',\n    serviceName='test-service3',\n    taskDefinition='test-task3',\n    desiredCount=2,\n    launchType='FARGATE',\n    networkConfiguration={\n        'awsvpcConfiguration': {\n            'subnets': ['subnet-default-us-east-1-a', 'subnet-default-us-east-1-b'],\n            'securityGroups': [sg_id],\n            'assignPublicIp': 'ENABLED'\n        }\n    }\n)\n\n# Wait for tasks\ntime.sleep(8)\ntasks = ecs.list_tasks(cluster='test-cluster3', serviceName='test-service3')\nprint(f\"Tasks: {len(tasks.get('taskArns', []))}\")\n\nif tasks.get('taskArns'):\n    task_details = ecs.describe_tasks(cluster='test-cluster3', tasks=tasks['taskArns'])\n    for t in task_details.get('tasks', []):\n        print(f\"Task: {t['taskArn']}\")\n        print(f\"  Status: {t.get('lastStatus', '')}\")\n        print(f\"  Containers: {json.dumps([{k: c.get(k) for k in ['name', 'lastStatus', 'healthStatus']} for c in t.get('containers', [])])}\")\n        for eni in t.get('attachments', []):\n            print(f\"  Attachment type: {eni.get('attachmentType')}\")\n            for detail in eni.get('details', []):\n                print(f\"    {detail['name']}: {detail['value']}\")\n        \n        # Check ENI\n        eni_id = None\n        for eni in t.get('attachments', []):\n            for detail in eni.get('details', []):\n                if detail['name'] == 'networkInterfaceId':\n                    eni_id = detail['value']\n        if eni_id:\n            try:\n                eni_info = ec2.describe_network_interfaces(NetworkInterfaceIds=[eni_id])\n                eni = eni_info['NetworkInterfaces'][0]\n                print(f\"  ENI PrivateIP: {eni.get('PrivateIpAddress')}\")\n                print(f\"  ENI PublicIP: {eni.get('Association', {}).get('PublicIp')}\")\n                print(f\"  ENI SubnetId: {eni.get('SubnetId')}\")\n            except Exception as e:\n                print(f\"  ENI error: {e}\")\n\n# Cleanup\necs.delete_service(cluster='test-cluster3', service='test-service3', force=True)\ntime.sleep(2)\necs.deregister_task_definition(taskDefinition=task_arn)\necs.delete_cluster(cluster='test-cluster3')\nec2.delete_security_group(GroupId=sg_id)\niam.delete_role(RoleName='test-ecs-exec3')\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
