/A')}\")\nprint(f\"Service status: {svc.get('status', 'N/A')}\")\nprint(f\"Desired count: {svc.get('desiredCount', 'N/A')}\")\nprint(f\"Running count: {svc.get('runningCount', 'N/A')}\")\n\n# Wait and check tasks\ntime.sleep(5)\ntasks = ecs.list_tasks(cluster='test-cluster2', serviceName='test-service2')\nprint(f\"Tasks: {tasks.get('taskArns', [])}\")\n\nif tasks.get('taskArns'):\n    task_details = ecs.describe_tasks(cluster='test-cluster2', tasks=tasks['taskArns'])\n    for t in task_details.get('tasks', []):\n        print(f\"  Status: {t.get('lastStatus', '')}, Desired: {t.get('desiredStatus', '')}\")\n        for eni in t.get('attachments', []):\n            for detail in eni.get('details', []):\n                print(f\"  {detail['name']}: {detail['value']}\")\nelse:\n    print(\"No tasks found\")\n\n# Check service again\nsvc2 = ecs.describe_services(cluster='test-cluster2', services=['test-service2'])\ns = svc2.get('services', [{}])[0]\nprint(f\"Service running: {s.get('runningCount', 0)}, pending: {s.get('pendingCount', 0)}\")\n\n# Cleanup\necs.delete_service(cluster='test-cluster2', service='test-service2', force=True)\necs.deregister_task_definition(taskDefinition=task_arn)\necs.delete_cluster(cluster='test-cluster2')\niam.delete_role(RoleName='test-ecs-exec2')\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
