timestamp=2026-10-03T16:27:36.692Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json, http.client, hashlib, hmac, time\nfrom botocore.awsrequest import AWSRequest\nfrom botocore.auth import SigV4Auth\nfrom botocore.credentials import Credentials\nfrom botocore.session import Session\n\n# Get credentials\ncreds = Credentials('test', 'test')\n\nLB_ARN = \"arn:aws:elasticloadbalancing:us-east-1:000000000000:loadbalancer/app/lst-final-alb/68fb5c8c117843c5\"\nTG_ARN = \"arn:aws:elasticloadbalancing:us-east-1:000000000000:targetgroup/lst-final-tg/a8bd236c52a3492b\"\n\n# First recreate the LB and TG\nc = boto3.client('elbv2', endpoint_url='http://aws:4566', region_name='us-east-1')\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\nsg = ec2.create_security_group(GroupName='lst-raw-sg', Description='test', VpcId='vpc-default-us-east-1')\nlb = c.create_load_balancer(Name='lst-raw-alb', Subnets=['subnet-default-us-east-1-a','subnet-default-us-east-1-b'], SecurityGroups=[sg['GroupId']])\nlb_arn = lb['LoadBalancers'][0]['LoadBalancerArn']\ntg = c.create_target_group(Name='lst-raw-tg', Protocol='HTTP', Port=8080, TargetType='ip', VpcId='vpc-default-us-east-1')\ntg_arn = tg['TargetGroups'][0]['TargetGroupArn']\n\n# Try with raw HTTP request using SigV4\nimport urllib.request\nbody = json.dumps({\n    \"LoadBalancerArn\": lb_arn,\n    \"Protocol\": \"HTTP\",\n    \"Port\": 80,\n    \"DefaultActions\": [{\"Type\": \"forward\", \"TargetGroupArn\": tg_arn}]\n})\n\nreq = AWSRequest(method='POST', url='http://aws:4566/', data=body)\nreq.headers['Content-Type'] = 'application/x-amz-json-1.1'\nreq.headers['X-Amz-Target'] = 'ElasticLoadBalancing_v20151201.CreateListener'\nSigV4Auth(creds, 'elasticloadbalancing', 'us-east-1').add_auth(req)\n\ntry:\n    resp = urllib.request.urlopen(urllib.request.Request(\n        'http://aws:4566/',\n        data=body.encode(),\n        headers=dict(req.headers),\n        method='POST'\n    ))\n    print(\"SUCCESS:\", resp.read().decode()[:500])\nexcept urllib.error.HTTPError as e:\n    print(f\"HTTP {e.code}:\", e.read().decode()[:500])\n\n# Cleanup\nc.delete_load_balancer(LoadBalancerArn=lb_arn)\nc.delete_target_group(TargetGroupArn=tg_arn)\nec2.delete_security_group(GroupId=sg['GroupId'])\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
