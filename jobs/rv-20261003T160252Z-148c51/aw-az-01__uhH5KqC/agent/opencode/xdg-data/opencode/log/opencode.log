timestamp=2026-10-03T16:29:20.472Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json, time\n\necs = boto3.client('ecs', endpoint_url='http://aws:4566', region_name='us-east-1')\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\niam = boto3.client('iam', endpoint_url='http://aws:4566', region_name='us-east-1')\n\n# Create IAM role for ECS task execution\ntry:\n    role = iam.create_role(RoleName='test-ecs-exec', AssumeRolePolicyDocument=json.dumps({\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}]\n    }))\n    role_arn = role['Role']['Arn']\nexcept Exception as e:\n    role_arn = 'arn:aws:iam::000000000000:role/test-ecs-exec'\n\n# Create cluster\ncluster = ecs.create_cluster(clusterName='test-cluster')\nprint(f\"Cluster: {cluster.get('clusterArn', 'N/A')}\")\n\n# Create task definition\ntask_def = ecs.register_task_definition(\n    family='test-task',\n    requiresCompatibilities=['FARGATE'],\n    networkMode='awsvpc',\n    cpu='256',\n    memory='512',\n    executionRoleArn=role_arn,\n    containerDefinitions=json.dumps([{\n        'name': 'api',\n        'image': 'clearledger/api:1.0.0',\n        'portMappings': [{'containerPort': 8080, 'protocol': 'tcp'}],\n        'environment': [{'name': 'PORT', 'value': '8080'}],\n    }])\n)\nprint(f\"Task def: {task_def.get('taskDefinition', {}).get('taskDefinitionArn', 'N/A')}\")\n\n# Create service\nsvc = ecs.create_service(\n    cluster='test-cluster',\n    serviceName='test-service',\n    taskDefinition='test-task',\n    desiredCount=1,\n    launchType='FARGATE',\n    networkConfiguration={\n        'awsvpcConfiguration': {\n            'subnets': ['subnet-default-us-east-1-a'],\n            'securityGroups': [],\n            'assignPublicIp': 'DISABLED'\n        }\n    }\n)\nprint(f\"Service: {svc.get('serviceArn', 'N/A')}\")\n\n# Wait and check tasks\ntime.sleep(5)\ntasks = ecs.list_tasks(cluster='test-cluster', serviceName='test-service')\nprint(f\"Tasks: {tasks.get('taskArns', [])}\")\n\nif tasks.get('taskArns'):\n    task_details = ecs.describe_tasks(cluster='test-cluster', tasks=tasks['taskArns'])\n    for t in task_details.get('tasks', []):\n        print(f\"  Task: {t.get('taskArn', '')}, Status: {t.get('lastStatus', '')}, Desired: {t.get('desiredStatus', '')}\")\n        for eni in t.get('attachments', []):\n            for detail in eni.get('details', []):\n                if detail['name'] == 'networkInterfaceId':\n                    print(f\"  ENI: {detail['value']}\")\n                if detail['name'] in ('privateIPv4Address', 'publicIPv4Address'):\n                    print(f\"  {detail['name']}: {detail['value']}\")\n\n# Cleanup\necs.delete_service(cluster='test-cluster', service='test-service', force=True)\necs.deregister_task_definition(taskDefinition=task_def['taskDefinition']['taskDefinitionArn'])\necs.delete_cluster(cluster='test-cluster')\niam.delete_role(RoleName='test-ecs-exec')\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
