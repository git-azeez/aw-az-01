timestamp=2026-10-03T16:27:48.154Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json\nfrom botocore.endpoint import Endpoint\n\n# Capture the actual request\nclass CapturingEndpoint(Endpoint):\n    def _do_get_response(self, request, operation_model):\n        print(\"=== CAPTURED REQUEST ===\")\n        print(\"URL:\", request.url)\n        print(\"Method:\", request.method)\n        print(\"Headers:\", dict(request.headers))\n        print(\"Body:\", request.body[:500] if request.body else \"None\")\n        return super()._do_get_response(request, operation_model)\n\nc = boto3.client('elbv2', endpoint_url='http://aws:4566', region_name='us-east-1')\n\n# Create resources first\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\nsg = ec2.create_security_group(GroupName='lst-cap-sg', Description='test', VpcId='vpc-default-us-east-1')\nlb = c.create_load_balancer(Name='lst-cap-alb', Subnets=['subnet-default-us-east-1-a','subnet-default-us-east-1-b'], SecurityGroups=[sg['GroupId']])\nlb_arn = lb['LoadBalancers'][0]['LoadBalancerArn']\ntg = c.create_target_group(Name='lst-cap-tg', Protocol='HTTP', Port=8080, TargetType='ip', VpcId='vpc-default-us-east-1')\ntg_arn = tg['TargetGroups'][0]['TargetGroupArn']\n\n# Monkey-patch to capture\nimport botocore.client\norig = botocore.client.ClientCreator._create_client if hasattr(botocore.client.ClientCreator, '_create_client') else None\n\n# Use event system instead\ndef capture_request(**kwargs):\n    print(\"=== REQUEST ===\")\n    req = kwargs.get('request')\n    if req:\n        print(\"URL:\", req.url)\n        print(\"Body:\", req.body[:500] if req.body else \"None\")\n        print(\"Headers:\", {k:v for k,v in req.headers.items() if k.lower() in ['content-type', 'x-amz-target']})\n\nc.meta.events.register('before-call.elasticloadbalancingv2.CreateListener', capture_request)\n\ntry:\n    c.create_listener(LoadBalancerArn=lb_arn, Protocol='HTTP', Port=80, DefaultActions=[{\"Type\":\"forward\",\"TargetGroupArn\":tg_arn}])\nexcept Exception as e:\n    print(\"Error:\", str(e)[:200])\n\n# Cleanup\nc.delete_load_balancer(LoadBalancerArn=lb_arn)\nc.delete_target_group(TargetGroupArn=tg_arn)\nec2.delete_security_group(GroupId=sg['GroupId'])\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
