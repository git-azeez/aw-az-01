timestamp=2026-10-03T16:30:02.666Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json, time, socket\n\necs = boto3.client('ecs', endpoint_url='http://aws:4566', region_name='us-east-1')\niam = boto3.client('iam', endpoint_url='http://aws:4566', region_name='us-east-1')\n\n# Create role\ntry:\n    iam.create_role(RoleName='test-port-scan', AssumeRolePolicyDocument=json.dumps({\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}]\n    }))\nexcept: pass\nrole_arn = 'arn:aws:iam::000000000000:role/test-port-scan'\n\n# Create cluster and task\necs.create_cluster(clusterName='test-ps-cluster')\ntask_def = ecs.register_task_definition(\n    family='test-ps-task',\n    requiresCompatibilities=['FARGATE'],\n    networkMode='awsvpc',\n    cpu='256',\n    memory='512',\n    executionRoleArn=role_arn,\n    containerDefinitions=[{\n        'name': 'api',\n        'image': 'clearledger/api:1.0.0',\n        'portMappings': [{'containerPort': 8080, 'protocol': 'tcp'}],\n        'environment': [{'name': 'PORT', 'value': '8080'}],\n    }]\n)\necs.create_service(\n    cluster='test-ps-cluster',\n    serviceName='test-ps-service',\n    taskDefinition='test-ps-task',\n    desiredCount=1,\n    launchType='FARGATE',\n    networkConfiguration={'awsvpcConfiguration': {\n        'subnets': ['subnet-default-us-east-1-a'],\n        'securityGroups': [],\n        'assignPublicIp': 'ENABLED'\n    }}\n)\ntime.sleep(3)\n\n# Scan ports on aws host\nprint(\"Scanning ports on aws host...\")\nopen_ports = []\nfor port in range(8080, 8100):\n    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    sock.settimeout(0.2)\n    result = sock.connect_ex(('aws', port))\n    if result == 0:\n        open_ports.append(port)\n    sock.close()\n\n# Also check some common ports\nfor port in [80, 443, 3000, 5000, 8080, 9090, 4566, 4567, 4568, 4569, 4570, 4571, 4572, 4573, 4574, 4575, 4576, 4577, 4578, 4579, 4580]:\n    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    sock.settimeout(0.2)\n    result = sock.connect_ex(('aws', port))\n    if result == 0:\n        open_ports.append(port)\n    sock.close()\n\nprint(f\"Open ports: {sorted(set(open_ports))}\")\n\n# Try curling port 8080\nimport urllib.request\nfor port in [8080, 8081, 8082]:\n    try:\n        r = urllib.request.urlopen(f'http://aws:{port}/health/ready', timeout=1)\n        print(f\"Port {port}: {r.status} {r.read()[:100]}\")\n    except Exception as e:\n        print(f\"Port {port}: {str(e)[:100]}\")\n\n# Cleanup\necs.delete_service(cluster='test-ps-cluster', service='test-ps-service', force=True)\ntime.sleep(1)\necs.deregister_task_definition(taskDefinition=task_def['taskDefinition']['taskDefinitionArn'])\necs.delete_cluster(cluster='test-ps-cluster')\niam.delete_role(RoleName='test-port-scan')\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
