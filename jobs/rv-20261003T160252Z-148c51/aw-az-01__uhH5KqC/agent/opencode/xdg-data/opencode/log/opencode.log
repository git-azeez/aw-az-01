timestamp=2026-10-03T16:28:35.151Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json\n\nc = boto3.client('elbv2', endpoint_url='http://aws:4566', region_name='us-east-1',\n                  config=boto3.session.Config(retries={'max_attempts': 0}))\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\nsg = ec2.create_security_group(GroupName='lst-tag-sg', Description='test', VpcId='vpc-default-us-east-1')\nlb = c.create_load_balancer(Name='lst-tag-alb', Subnets=['subnet-default-us-east-1-a','subnet-default-us-east-1-b'], SecurityGroups=[sg['GroupId']])\nlb_arn = lb['LoadBalancers'][0]['LoadBalancerArn']\ntg = c.create_target_group(Name='lst-tag-tg', Protocol='HTTP', Port=8080, TargetType='ip', VpcId='vpc-default-us-east-1')\ntg_arn = tg['TargetGroups'][0]['TargetGroupArn']\n\n# Try with tags\ntry:\n    r = c.create_listener(LoadBalancerArn=lb_arn, Protocol='HTTP', Port=80, \n        DefaultActions=[{\"Type\":\"forward\",\"TargetGroupArn\":tg_arn}],\n        Tags=[{\"Key\":\"ClearLedgerDeployment\",\"Value\":\"test\"}])\n    print(\"WITH TAGS SUCCESS:\", json.dumps(r.get('Listeners',[{}])[0], default=str)[:300])\nexcept Exception as e:\n    print(\"WITH TAGS FAIL:\", str(e)[:200])\n\n# Try with port as different values\nfor port in [9999, 4566, 3000]:\n    try:\n        r = c.create_listener(LoadBalancerArn=lb_arn, Protocol='HTTP', Port=port, \n            DefaultActions=[{\"Type\":\"forward\",\"TargetGroupArn\":tg_arn}])\n        print(f\"PORT {port} SUCCESS\")\n        break\n    except Exception as e:\n        print(f\"PORT {port} FAIL: {str(e)[:100]}\")\n\n# Cleanup\nc.delete_load_balancer(LoadBalancerArn=lb_arn)\nc.delete_target_group(TargetGroupArn=tg_arn)\nec2.delete_security_group(GroupId=sg['GroupId'])\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
