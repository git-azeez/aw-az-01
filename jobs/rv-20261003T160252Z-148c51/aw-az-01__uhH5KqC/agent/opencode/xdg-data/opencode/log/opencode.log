timestamp=2026-10-03T16:28:48.691Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json, logging\n\n# Enable botocore debug logging\nlogging.basicConfig(level=logging.DEBUG)\nboto_logger = logging.getLogger('botocore')\nboto_logger.setLevel(logging.DEBUG)\n\n# Add a handler to capture specific log lines\nclass CaptureHandler(logging.Handler):\n    def __init__(self):\n        super().__init__()\n        self.lines = []\n    def emit(self, record):\n        msg = self.format(record)\n        if 'CreateListener' in msg or 'InternalFailure' in msg or 'response' in msg.lower() or '500' in msg:\n            self.lines.append(msg)\n\ncap = CaptureHandler()\ncap.setLevel(logging.DEBUG)\nboto_logger.addHandler(cap)\n\nc = boto3.client('elbv2', endpoint_url='http://aws:4566', region_name='us-east-1',\n                  config=boto3.session.Config(retries={'max_attempts': 0}))\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\nsg = ec2.create_security_group(GroupName='lst-dbg2-sg', Description='test', VpcId='vpc-default-us-east-1')\nlb = c.create_load_balancer(Name='lst-dbg2-alb', Subnets=['subnet-default-us-east-1-a','subnet-default-us-east-1-b'], SecurityGroups=[sg['GroupId']])\nlb_arn = lb['LoadBalancers'][0]['LoadBalancerArn']\ntg = c.create_target_group(Name='lst-dbg2-tg', Protocol='HTTP', Port=8080, TargetType='ip', VpcId='vpc-default-us-east-1')\ntg_arn = tg['TargetGroups'][0]['TargetGroupArn']\n\ntry:\n    r = c.create_listener(LoadBalancerArn=lb_arn, Protocol='HTTP', Port=80, DefaultActions=[{\"Type\":\"forward\",\"TargetGroupArn\":tg_arn}])\nexcept Exception as e:\n    pass\n\n# Print captured lines\nfor line in cap.lines[-20:]:\n    print(line[:500])\n\n# Cleanup\nc.delete_load_balancer(LoadBalancerArn=lb_arn)\nc.delete_target_group(TargetGroupArn=tg_arn)\nec2.delete_security_group(GroupId=sg['GroupId'])\nPYEOF" action.permission=* action.action=allow action.pattern=*
