timestamp=2026-10-03T16:26:35.333Z level=INFO run=bf8e0989 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport boto3, json, time\n\nc = boto3.client('elbv2', endpoint_url='http://aws:4566', region_name='us-east-1')\nec2 = boto3.client('ec2', endpoint_url='http://aws:4566', region_name='us-east-1')\n\n# Create SG\nsg = ec2.create_security_group(GroupName='lst-final-sg', Description='test', VpcId='vpc-default-us-east-1')\nsg_id = sg['GroupId']\nprint(f\"SG={sg_id}\")\n\n# Create ALB\nlb = c.create_load_balancer(Name='lst-final-alb', Subnets=['subnet-default-us-east-1-a','subnet-default-us-east-1-b'], SecurityGroups=[sg_id])\nlb_arn = lb['LoadBalancers'][0]['LoadBalancerArn']\nprint(f\"LB={lb_arn}\")\n\n# Create TG\ntg = c.create_target_group(Name='lst-final-tg', Protocol='HTTP', Port=8080, TargetType='ip', VpcId='vpc-default-us-east-1')\ntg_arn = tg['TargetGroups'][0]['TargetGroupArn']\nprint(f\"TG={tg_arn}\")\n\n# Try CreateListener with ForwardConfig\nfor attempt_name, actions in [\n    (\"simple\", [{\"Type\":\"forward\",\"TargetGroupArn\":tg_arn}]),\n    (\"forward_config\", [{\"Type\":\"forward\",\"ForwardConfig\":{\"TargetGroups\":[{\"TargetGroupArn\":tg_arn,\"Weight\":100}]}}]),\n    (\"with_order\", [{\"Type\":\"forward\",\"TargetGroupArn\":tg_arn,\"Order\":1}]),\n]:\n    try:\n        r = c.create_listener(LoadBalancerArn=lb_arn, Protocol='HTTP', Port=80, DefaultActions=actions)\n        print(f\"{attempt_name} SUCCESS: {json.dumps(r.get('Listeners',[{}])[0], default=str)[:200]}\")\n        break\n    except Exception as e:\n        print(f\"{attempt_name} FAIL: {str(e)[:200]}\")\n\n# Cleanup\nc.delete_load_balancer(LoadBalancerArn=lb_arn)\nc.delete_target_group(TargetGroupArn=tg_arn)\nec2.delete_security_group(GroupId=sg_id)\nprint(\"cleaned\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
