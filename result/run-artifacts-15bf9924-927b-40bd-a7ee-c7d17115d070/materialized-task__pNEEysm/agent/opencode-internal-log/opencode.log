timestamp=2026-10-10T14:56:01.876Z level=INFO run=37e72828 message=evaluated permission=bash pattern="cat > /tmp/dev/smoke.py <<'EOF'\nimport json, requests, uuid, time, sys, datetime\nM=json.load(open('/tmp/manifest.json'))\nbase='http://aws:80'\ndef tok(n):\n    c=M['auth']['clients'][n]\n    r=requests.post(M['auth']['token_endpoint'],auth=(c['client_id'],c['client_secret']),data={'grant_type':'client_credentials','scope':c['scope']})\n    return r.json()['access_token']\nT={n:tok(n) for n in ('read','write','admin')}\ndef H(n,**k): \n    h={'Authorization':'Bearer '+T[n],'X-Correlation-Id':'smoke-'+uuid.uuid4().hex[:8]}\n    h.update(k); return h\nsid=str(uuid.uuid4())\nnow=datetime.datetime.now(datetime.timezone.utc)\nr=requests.post(base+'/v1/settlements',headers=H('write',**{'Idempotency-Key':'idem-'+uuid.uuid4().hex}),json=dict(settlementId=sid,accountId='ACC-100',reference='REF-1',debitParty='BankA',creditParty='BankB',expectedVersion=0))\nprint(r.status_code,r.text,dict(r.headers))\nt=(now+datetime.timedelta(seconds=5)).isoformat().replace('+00:00','Z')\nr=requests.post(base+f'/v1/settlements/{sid}/entries',headers=H('write',**{'Idempotency-Key':'idem-'+uuid.uuid4().hex}),json=dict(entryId=str(uuid.uuid4()),status='VALIDATED',clearingStage='validation',memo='ok memo',occurredAt=t,expectedVersion=1))\nprint(r.status_code,r.text)\nt=(now+datetime.timedelta(seconds=10)).isoformat().replace('+00:00','Z')\nr=requests.post(base+f'/v1/settlements/{sid}/entries',headers=H('write',**{'Idempotency-Key':'idem-'+uuid.uuid4().hex}),json=dict(entryId=str(uuid.uuid4()),status='CLEARED',clearingStage='clearing',occurredAt=t,expectedVersion=2))\nprint(r.status_code,r.text)\nprint(sid)\nopen('/tmp/sid','w').write(sid)\nEOF" action.permission=* action.action=allow action.pattern=*
