timestamp=2026-10-10T15:02:13.999Z level=INFO run=37e72828 message=evaluated permission=bash pattern="python3 - <<'EOF'\ns=open('outputs.tf').read()\ns=s.replace('service_url     = \"http://${aws_lb.main.dns_name}\"','service_url     = \"http://${local.endpoint_host}:80\"')\nopen('outputs.tf','w').write(s)\nm=open('main.tf').read()\nm=m.replace(\"  tags = {\\n    ClearLedgerDeployment = local.prefix\\n  }\\n\",\"  tags = {\\n    ClearLedgerDeployment = local.prefix\\n  }\\n\\n  # The local control plane fronts the ALB listener on <endpoint-host>:80.\\n  endpoint_host = regex(\\\"^https?://([^:/]+)\\\", local.cfg.aws_endpoint_url)[0]\\n\",1)\nopen('main.tf','w').write(m)\nc=open('compute.tf').read()\nfor n,k in (('projector','projector'),('outbox-relay','relay'),('audit-archiver','archiver')):\n    c=c.replace('tags       = merge(local.tags, { Name = \"${local.prefix}-%s\" })'%n,'tags       = merge(local.tags, { Name = \"${local.prefix}-%s\", ImageId = local.cfg.%s_image_id })'%(n,k))\nopen('compute.tf','w').write(c)\nEOF" action.permission=* action.action=allow action.pattern=*
