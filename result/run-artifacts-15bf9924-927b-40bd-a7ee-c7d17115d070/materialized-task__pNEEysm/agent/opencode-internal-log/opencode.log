timestamp=2026-10-10T15:02:32.743Z level=INFO run=37e72828 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport sys; sys.path.insert(0,'/tmp')\nfrom aws import *\nimport redis\nd=c('dynamodb'); T='cl-22358f-projections'\nd.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#deadbeef-0000-0000-0000-000000000000'},'SK':{'S':'STATE'},'version':{'N':'9'}})\nsid=open('/tmp/sid').read()\nd.update_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+sid},'SK':{'S':'STATE'}},UpdateExpression='SET #s=:s, extra=:e',ExpressionAttributeNames={'#s':'status'},ExpressionAttributeValues={':s':{'S':'SETTLED'},':e':{'S':'x'}})\nd.delete_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+sid},'SK':{'S':'EVENT#00000002'}})\nd.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#'+sid},'SK':{'S':'EVENT#00000009'}})\nr=redis.Redis(host='aws',port=6379); r.set('stray','1'); r.set('clearledger:settlement:ghost','{}',ex=50)\ns3=c('s3'); s3.put_object(Bucket='cl-22358f-audit-archive',Key='junk.txt',Body=b'x'); s3.delete_object(Bucket='cl-22358f-audit-archive',Key='ledger-audit/batch-00000001-00000003-0674787676ee7e88.ndjson')\nEOF" action.permission=* action.action=allow action.pattern=*
