def emit(**event):
    print(json.dumps(event, separators=(",", ":")), file=sys.stderr, flush=True)


def is_messages_path(path):
    return path == "/messages" or path.startswith("/messages?") or path == "/v1/messages" or path.startswith(
        "/v1/messages?"
    )


def upstream_path(path):
    if UPSTREAM_PATH_PREFIX:
        return f"{UPSTREAM_PATH_PREFIX}{path}"
    return f"/v1{path}" if path == "/messages" or path.startswith("/messages?") else path


def is_anthropic_model(model):
    return isinstance(model, str) and (model.startswith("anthropic/") or model.startswith("claude-"))


def retry_after_seconds(value):
    if not value:
        return None
    try:
        delay = float(value)
    except ValueError:
        try:
            retry_at = parsedate_to_datetime(value)
            if retry_at.tzinfo is None:
                retry_at = retry_at.replace(tzinfo=timezone.utc)
            delay = max(0.0, (retry_at - datetime.now(timezone.utc)).total_seconds())
        except (TypeError, ValueError, OverflowError):
            return None
    return delay if 0.0 <= delay <= RATE_LIMIT_MAX_DELAY_SEC else None


def rate_limit_count(headers, name):
    value = headers.get(name) if headers else None
    return int(value) if isinstance(value, str) and value.isascii() and value.isdecimal() and len(value) <= 12 else None


def response_metrics(headers):
    return {
        "output_token_limit": rate_limit_count(headers, "anthropic-ratelimit-output-tokens-limit"),
        "output_tokens_remaining": rate_limit_count(headers, "anthropic-ratelimit-output-tokens-remaining"),
    }


def rewrite_body_if_needed(method, path, body):
    if method != "POST" or not is_messages_path(path):
        return body
    try:
        payload = json.loads(body)
    except (TypeError, ValueError):
        return body
    if (
        isinstance(payload, dict)
        and is_anthropic_model(payload.get("model"))
        and payload.get("max_tokens") == TARGET_MAX_TOKENS
    ):
        payload["max_tokens"] = REWRITE_MAX_TOKENS
        emit(
            event="opus_anthropic_proxy.rewrite",
            model=payload.get("model"),
            old_max_tokens=TARGET_MAX_TOKENS,
            new_max_tokens=REWRITE_MAX_TOKENS,
            path=path,
        )
        return json.dumps(payload, separators=(",", ":")).encode()
    return body


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, _format, *_args):
        return

    def do_GET(self):
        if self.path == "/health":
            body = b"ok"
            self.send_response(200)
            self.send_header("content-type", "text/plain")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        self._proxy()

    def do_POST(self):
        self._proxy()

    def do_PUT(self):
        self._proxy()

    def do_PATCH(self):
        self._proxy()

    def do_DELETE(self):
        self._proxy()

    def _proxy(self):
        try:
            length = int(self.headers.get("content-length", "0"))
        except ValueError:
            length = 0
        body = rewrite_body_if_needed(self.command, self.path, self.rfile.read(max(0, length)))
        headers = {key: value for key, value in self.headers.items() if key.lower() not in HOP_HEADERS}
        url = f"{UPSTREAM_PROTOCOL}//{UPSTREAM_HOST}:{UPSTREAM_PORT}{upstream_path(self.path)}"
        request_body = None if self.command in {"GET", "HEAD"} else body
        upstream_request = urlrequest.Request(
            url,
            data=request_body,
            headers=headers,
            method=self.command,
        )
        for attempt in range(1, RATE_LIMIT_MAX_ATTEMPTS + 1):
            started = time.monotonic()
            try:
                upstream = urlrequest.urlopen(upstream_request, timeout=UPSTREAM_TIMEOUT)
                break
            except urlerror.HTTPError as exc:
                delay = (
                    retry_after_seconds(exc.headers.get("retry-after") if exc.headers else None)
                    if exc.code == 429
                    else None
                )
                retry_eligible = delay is not None and attempt < RATE_LIMIT_MAX_ATTEMPTS
                emit(
                    event="opus_anthropic_proxy.http_error",
                    status=exc.code,
                    attempt=attempt,
                    retry_eligible=retry_eligible,
                    elapsed_ms=int((time.monotonic() - started) * 1000),
                    **response_metrics(exc.headers),
                )
                if delay is None or attempt == RATE_LIMIT_MAX_ATTEMPTS:
                    upstream = exc
                    break
                exc.close()
                emit(
                    event="opus_anthropic_proxy.rate_limit_retry",
                    attempt=attempt,
                    delay_sec=delay,
                    status=exc.code,
                )
                time.sleep(delay)
            except Exception as exc:
                emit(event="opus_anthropic_proxy.upstream_error", message=str(exc))
                error_body = f"upstream error: {exc}".encode()
                self.send_response(502)
                self.send_header("content-type", "text/plain")
                self.send_header("content-length", str(len(error_body)))
                self.end_headers()
                self.wfile.write(error_body)
                return

        status = int(getattr(upstream, "status", None) or upstream.getcode() or 502)
        emit(
            event="opus_anthropic_proxy.response_start",
            path=self.path,
            status=status,
            attempt=attempt,
            elapsed_ms=int((time.monotonic() - started) * 1000),
            **response_metrics(upstream.headers),
        )
        self.send_response(status)
        for key, value in upstream.headers.items():
            if key.lower() not in HOP_HEADERS:
                self.send_header(key, value)
        self.send_header("connection", "close")
        self.end_headers()
        self.close_connection = True
        last_progress = time.monotonic()
        try:
            while chunk := upstream.read(65536):
                self.wfile.write(chunk)
                self.wfile.flush()
                if time.monotonic() - last_progress >= 30:
                    last_progress = time.monotonic()
                    emit(event="opus_anthropic_proxy.stream_progress", path=self.path, status=status)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            upstream.close()
            emit(event="opus_anthropic_proxy.response_end", path=self.path, status=status)


emit(
    event="opus_anthropic_proxy.ready",
    port=PORT,
    rewrite_max_tokens=REWRITE_MAX_TOKENS,
    upstream_host=UPSTREAM_HOST,
)
