let errsSinceProgress = 0;
let llmCallsCompleted = 0;
let llmFailures = 0;
let everSawAgent = false;
let agentGoneStreak = 0;
let lastChildSig = "";
let lastTreeCpu = -1;
let stalled = false;
const startMs = Date.now();
