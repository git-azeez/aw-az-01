function heartbeat(obj) { console.log(JSON.stringify({ ts: new Date().toISOString(), ...obj })); }

function newestMtimeMs(dir) {
  let newest = 0;
  const stack = [dir];
  while (stack.length) {
    const d = stack.pop();
    let entries;
    try { entries = fs.readdirSync(d, { withFileTypes: true }); } catch { continue; }
    for (const e of entries) {
      const p = path.join(d, e.name);
      if (e.isDirectory()) { stack.push(p); continue; }
      try { const m = fs.statSync(p).mtimeMs; if (m > newest) newest = m; } catch {}
    }
  }
  return newest;
}

const offsets = new Map();
function appended(file) {
  let st;
  try { st = fs.statSync(file); } catch { return ""; }
  let prev = offsets.get(file) ?? 0;
  if (st.size < prev) prev = 0; // rotated/truncated
  const start = Math.max(prev, st.size - (1 << 20)); // cap 1MB per probe
  offsets.set(file, st.size);
  if (st.size <= start) return "";
  const buf = Buffer.alloc(st.size - start);
  try {
    const fd = fs.openSync(file, "r");
    fs.readSync(fd, buf, 0, buf.length, start);
    fs.closeSync(fd);
  } catch { return ""; }
  return buf.toString("utf8");
}

function ocLogFiles() {
  try { return fs.readdirSync(OC_LOG_DIR).map((f) => path.join(OC_LOG_DIR, f)); } catch { return []; }
}

// cmdline invokes the opencode binary ("/bin/opencode --model=..." or a
// wrapping "bash -lc ... opencode --model ..."); "opencode/log" paths and
// "opencode.txt" must NOT match.
const isAgentCmdline = (c) => /(^|\/|\s)opencode(\s|$)/.test(c) && !c.includes("m1_agent_progress_watchdog");

function scanProcs() {
  const procs = [];
  let names = [];
  try { names = fs.readdirSync(PROC_DIR); } catch {}
  for (const name of names) {
    if (!/^[0-9]+$/.test(name)) continue;
    const pid = Number(name);
    if (pid === process.pid) continue;
    let cmdline = "";
    try { cmdline = fs.readFileSync(path.join(PROC_DIR, name, "cmdline"), "utf8").replace(/\0/g, " ").trim(); } catch { continue; }
    if (!cmdline) continue;
    let ppid = 0, cpu = 0;
    try {
      const m = /^PPid:\s*([0-9]+)/m.exec(fs.readFileSync(path.join(PROC_DIR, name, "status"), "utf8"));
      if (m) ppid = Number(m[1]);
    } catch {}
    try {
      const stat = fs.readFileSync(path.join(PROC_DIR, name, "stat"), "utf8");
      const rest = stat.slice(stat.lastIndexOf(")") + 2).split(" ");
      cpu = Number(rest[11] || 0) + Number(rest[12] || 0); // utime + stime jiffies
    } catch {}
    procs.push({ pid, ppid, cmdline, cpu });
  }
  const agentPids = procs.filter((p) => isAgentCmdline(p.cmdline)).map((p) => p.pid);
  const agentSet = new Set(agentPids);
  const byParent = new Map();
  for (const p of procs) {
    if (!byParent.has(p.ppid)) byParent.set(p.ppid, []);
    byParent.get(p.ppid).push(p.pid);
  }
  const treeSet = new Set(agentPids);
  const stack = [...agentPids];
  while (stack.length) {
    for (const c of byParent.get(stack.pop()) || []) {
      if (!treeSet.has(c)) { treeSet.add(c); stack.push(c); }
    }
  }
  const childPids = [...treeSet].filter((p) => !agentSet.has(p));
  let treeCpu = 0;
  for (const p of procs) if (treeSet.has(p.pid)) treeCpu += p.cpu;
  return { agentPids, childPids, treeCpu };
}

function stall(kind, snapshot) {
  const detail = kind === "spin"
    ? `${snapshot.errs_since_progress} provider/tool errors with no completed agent step for ${snapshot.progress_age_s}s`
    : `no completed agent step, no running tool child, no CPU activity for ${snapshot.progress_age_s}s`;
  // Built non-contiguously on purpose: this script's source travels inside
  // exec commands, and a failed exec echoes the command into harbor's
  // stderr · a literal marker there would false-trip harbor_runner's
  // typed-stall stream check on a healthy run.
  const marker = { error_class: ["agent", "stalled", kind].join("-"), kind, detail, snapshot };
  const tmp = path.join(path.dirname(MARKER_PATH), `.${path.basename(MARKER_PATH)}.${process.pid}.tmp`);
  try { fs.writeFileSync(tmp, JSON.stringify(marker)); fs.renameSync(tmp, MARKER_PATH); }
  catch (e) { try { fs.unlinkSync(tmp); } catch {} heartbeat({ event: "marker_write_failed", message: String(e) }); }
  heartbeat({ event: "stall_kill", kind, detail, pids: snapshot.agent_pids });
  const pids = [...snapshot.agent_pids];
  for (const pid of pids) { try { process.kill(pid, "SIGTERM"); } catch {} }
  setTimeout(() => {
    for (const pid of pids) { try { process.kill(pid, "SIGKILL"); } catch {} }
    heartbeat({ event: "exit", reason: "stalled" });
    process.exit(0);
  }, KILL_GRACE_MS);
}

