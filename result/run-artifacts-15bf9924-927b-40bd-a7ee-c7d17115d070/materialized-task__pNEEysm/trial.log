// first 15 minutes" · which SIGKILLs a healthy agent that recovered eight
// scattered transients over a multi-hour run. That was latent while the
// level anchor matched nothing in opencode's logfmt; fixing the anchor arms
// it. Gate the spin kill on having a window into LLM traffic. Sticky: a
// proxy log appearing once is proof enough for the rest of the run.
// The `dead` kill deliberately stays armed when blind. With progress
// pinned it degenerates to a pure liveness test · no db write, no tool-child
// churn and sub-floor CPU for 40 minutes · which is exactly the frozen-agent
// shape, and the only in-sandbox protection those providers have.
let sighted = false;
function updateSighted() {
  if (sighted) return true;
  if (lastStorageNewest > 0) { sighted = true; return true; }
  for (const f of PROXY_LOGS) {
