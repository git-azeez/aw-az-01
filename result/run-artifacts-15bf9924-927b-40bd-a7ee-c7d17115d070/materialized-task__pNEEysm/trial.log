const STORAGE_DIR = env.M1_WATCHDOG_STORAGE_DIR || path.join(HOME, ".local/share/opencode/storage");
const DATA_DIR = env.M1_WATCHDOG_OPENCODE_DATA_DIR || path.join(HOME, ".local/share/opencode");
const OC_LOG_DIR = env.M1_WATCHDOG_OPENCODE_LOG_DIR || path.join(HOME, ".local/share/opencode/log");
const PROC_DIR = env.M1_WATCHDOG_PROC_DIR || "/proc";
