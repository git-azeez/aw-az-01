// Make the agent the LAST thing the kernel reaches for when the sandbox
// runs out of memory. It is never the process that filled the box · the
// measured cases are a `make -j128` fan-out sized off a host-reported
// nproc, and an MCP gateway holding 7.4 GiB of an 8 GiB sandbox, while the
// agent container itself peaks under 1 GiB. But `node` is one fat process
// and the OOM killer picks by size, so the agent dies, the run comes back
// as exit 137 with no reward, and the component that actually failed looks
// innocent. With the agent deprioritised the kernel takes the compiler or
// the leaking gateway instead, and the agent sees a normal tool failure it
// can react to. Set to 0 to disable. Verified writable in a live Daytona
// sandbox as uid 1001, and every failure is caught: a kernel that refuses
// the write logs one line per pid and the run carries on unprotected.
const OOM_SCORE_ADJ = env.M1_AGENT_OOM_SCORE_ADJ || "-500";
const oomProtected = new Set();
function protectAgents(pids) {
  if (OOM_SCORE_ADJ === "0") return;
  for (const pid of pids) {
    if (oomProtected.has(pid)) continue;
    try {
      fs.writeFileSync(path.join(PROC_DIR, String(pid), "oom_score_adj"), OOM_SCORE_ADJ);
      oomProtected.add(pid);
      heartbeat({ event: "oom_protect", pid, oom_score_adj: OOM_SCORE_ADJ });
