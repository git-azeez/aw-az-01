    "snapshot", process.execPath, "--experimental-sqlite", "-e", worker, source, partial],
    {timeout: 30000, killSignal: "SIGKILL", stdio: "ignore"});
  if (result.error || result.status !== 0 || fs.statSync(partial).size > cap) process.exit(1);
