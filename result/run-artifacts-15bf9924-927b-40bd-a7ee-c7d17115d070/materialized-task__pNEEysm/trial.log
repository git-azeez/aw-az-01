      // a hot retry loop shows up here even when opencode logs it below
      // ERROR level (or not at all)
      else if (
        (name.endsWith(".response_end") && !ok) ||
        name.endsWith(".request_error") ||
        name.endsWith(".headers_timeout") ||
        name.endsWith(".upstream_error") ||
        name.endsWith(".kill")
      ) { errsNew += 1; llmFailures += 1; }
    }
  }
  for (const f of ocLogFiles()) {
    for (const line of appended(f).split("\n")) {
      if (ERROR_LINE.test(line) || (WARN_LINE.test(line) && ERROR_TOKEN.test(line))) errsNew += 1;
    }
  }
  const childSig = childPids.join(",");
  if (childSig !== lastChildSig) { lastChildSig = childSig; lastLivenessMs = now; }
  const cpuDelta = lastTreeCpu >= 0 ? treeCpu - lastTreeCpu : 0;
  if (cpuDelta >= CPU_MIN_JIFFIES) lastLivenessMs = now;
  lastTreeCpu = treeCpu;

  if (progressed) { lastProgressMs = now; lastLivenessMs = now; errsSinceProgress = 0; }
  else errsSinceProgress += errsNew;
  const canSeeProgress = updateSighted();

  const snapshot = {
    alive: agentPids.length > 0,
    agent_pids: agentPids,
    tool_children: childPids.length,
    progress_age_s: Math.round((now - lastProgressMs) / 1000),
    liveness_age_s: Math.round((now - lastLivenessMs) / 1000),
    errs_since_progress: errsSinceProgress,
    storage_age_s: lastStorageNewest ? Math.round((now - lastStorageNewest) / 1000) : null,
    db_age_s: lastDbNewest ? Math.round((now - lastDbNewest) / 1000) : null,
    // cumulative proxy-observed LLM traffic · surfaced live in the dev-ui
    // vitals strip via the agent live-observer's probe events
    llm_calls_completed: llmCallsCompleted,
    llm_failures: llmFailures,
    // observed tree-CPU jiffies since the previous probe, against
    // CPU_MIN_JIFFIES. Recorded so the liveness floor is tunable from real
    // wedged-vs-working runs instead of guessed.
    cpu_delta_jiffies: cpuDelta,
    cpu_min_jiffies: CPU_MIN_JIFFIES,
    // false => no progress source exists for this run, so progress_age_s is
    // just the wall clock and errs_since_progress is a run-total. Both
    // still ship (they are the calibration data for a windowed spin rule
    // that would work when blind), but the spin kill does not read them.
    progress_observable: canSeeProgress,
  };
  heartbeat({ event: "probe", ...snapshot });
  if (!agentPids.length) return;
  if (canSeeProgress && errsSinceProgress >= SPIN_ERRORS && now - lastProgressMs >= SPIN_WINDOW_MS) {
    stalled = true;
    stall("spin", snapshot);
  } else if (now - lastProgressMs >= DEAD_WINDOW_MS && now - lastLivenessMs >= DEAD_WINDOW_MS) {
    stalled = true;
    stall("dead", snapshot);
  }
}

