  const now = Date.now();
  const { agentPids, childPids, treeCpu } = scanProcs();
  protectAgents(agentPids);
  if (agentPids.length) { everSawAgent = true; agentGoneStreak = 0; }
  else if (everSawAgent && ++agentGoneStreak >= 3) {
    heartbeat({ event: "exit", reason: "agent_exited" });
    process.exit(0);
  }
  if (!everSawAgent && now - startMs > 2 * DEAD_WINDOW_MS) {
    heartbeat({ event: "exit", reason: "agent_never_seen" });
    process.exit(0);
  }

  let progressed = false;
  let errsNew = 0;
  const storageNewest = newestMtimeMs(STORAGE_DIR);
  if (storageNewest > lastStorageNewest) { lastStorageNewest = storageNewest; progressed = true; }
  const dbNewest = dbNewestMtimeMs();
  if (dbNewest > lastDbNewest) { lastDbNewest = dbNewest; lastLivenessMs = now; }
  for (const f of PROXY_LOGS) {
    for (const line of appended(f).split("\n")) {
      if (!line.includes("_proxy.")) continue;
      let ev; try { ev = JSON.parse(line); } catch { continue; }
      // llm_idle_proxy.* (openai/openrouter) and opus_anthropic_proxy.*
      // share the same response-lifecycle suffixes · match by suffix.
      const name = String(ev.event || "");
      // strictly 2xx: a redirect/error loop must never read as progress
      const ok = Number(ev.status || 0) >= 200 && Number(ev.status || 0) < 300;
      if (name.endsWith(".response_end") && ok) { progressed = true; llmCallsCompleted += 1; }
      else if (ok && (name.endsWith(".response_start") || name.endsWith(".stream_progress"))) lastLivenessMs = now;
