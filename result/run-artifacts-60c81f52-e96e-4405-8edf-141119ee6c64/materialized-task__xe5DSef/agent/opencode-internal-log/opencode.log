timestamp=2026-10-10T05:55:23.909Z level=INFO run=5f6a65af message=evaluated permission=bash pattern="cat > /tmp/w/check.py <<'EOF'\nimport sys, json, hashlib, re\nsys.path.insert(0, '/workspace/submission/infra/scripts')\nimport clearledger_ops as o\nm = o.load_manifest(); pg = o.pg_from_manifest(m)\nbad = []\n# DynamoDB\n_, exp = o.expected_projection(pg)\nif not o.verify_dynamodb(m, exp): bad.append('dynamodb mismatch')\n# Valkey\nr = o.Resp(m['cache']['endpoint'], m['cache']['port'])\nkeys = {k.decode() for k in r.scan_all()}\nsids = [x['sid'] for x in pg.json('select settlement_id::text sid from clearledger.settlements')]\nwant = {f'clearledger:settlement:{s}' for s in sids}\nif keys != want: bad.append(f'valkey keys differ: extra={len(keys-want)} missing={len(want-keys)}')\nfor k in want & keys:\n    t = r.cmd('TTL', k)\n    if not (0 < t <= 90): bad.append(f'ttl {k} {t}')\n# S3\ns3 = o.aws('s3'); b = m['audit']['bucket_name']\nv, mk = o.list_versions(s3, b)\nif mk or any(not x['IsLatest'] for x in v): bad.append(f'noncurrent versions/markers: {len(mk)} markers')\nrows = o.outbox_rows(pg)\nacc, inv, _, _ = o.analyse_archive(s3, b, rows)\nif inv: bad.append(f'invalid s3 objects {[x[\"Key\"] for x in inv]}')\ncov = []\nseqs=[r_['seq'] for r_ in rows]; idx={s:i for i,s in enumerate(seqs)}\nfor f,l,_,_ in acc: cov += seqs[idx[f]:idx[l]+1]\nif sorted(cov) != seqs: bad.append(f's3 coverage mismatch {len(cov)} vs {len(seqs)}')\nif any(not r_['published'] or not r_['archived'] for r_ in rows): bad.append('outbox not fully published/archived')\n# control plane\nsqs = o.aws('sqs')\na = sqs.get_queue_attributes(QueueUrl=m['messaging']['queue_url'], AttributeNames=['All'])['Attributes']\nif a.get('VisibilityTimeout') != '3' or json.loads(a['RedrivePolicy'])['maxReceiveCount'] not in (4,'4'): bad.append(f'sqs main attrs {a.get(\"VisibilityTimeout\")} {a.get(\"RedrivePolicy\")}')\nd = sqs.get_queue_attributes(QueueUrl=m['messaging']['dlq_url'], AttributeNames=['All'])['Attributes']\nif d.get('MessageRetentionPeriod') != '1209600': bad.append('dlq retention')\nlam = o.aws('lambda')\nesm = lam.get_event_source_mapping(UUID=m['messaging']['event_source_mapping_uuid'])\nif esm['State'] != 'Enabled' or esm['BatchSize'] != 5: bad.append(f'esm {esm[\"State\"]}')\nenv = lam.get_function_configuration(FunctionName=m['workers']['outbox_relay']['function_name'])['Environment']['Variables']\nif env.get('OUTBOX_BATCH_SIZE') != '50': bad.append('relay env')\nsch = o.aws('scheduler')\nfor n, rate in ((m['schedules']['outbox_schedule_name'],'rate(1 minute)'),(m['schedules']['archive_schedule_name'],'rate(5 minutes)')):\n    s = sch.get_schedule(Name=n)\n    if s['ScheduleExpression'] != rate or s['State'] != 'ENABLED': bad.append(f'schedule {n}')\nlogs = o.aws('logs')\nfor g in m['logs'].values():\n    lg = logs.describe_log_groups(logGroupNamePrefix=g)['logGroups']\n    if not lg or lg[0].get('retentionInDays',0) < 14: bad.append(f'log {g}')\niam = o.aws('iam')\nfor role, pol in o.ROLE_POLICIES.items():\n    if iam.list_role_policies(RoleName=role)['PolicyNames'] != [pol] or iam.list_attached_role_policies(RoleName=role)['AttachedPolicies']: bad.append(f'iam {role}')\nif [p for p in o.list_local_policies(iam) if p['PolicyName'].startswith(o.PREFIX)]: bad.append('local policies remain')\nec2 = o.aws('ec2')\nfor k in ('rds','valkey'):\n    if ec2.describe_security_groups(GroupIds=[m['network']['security_group_ids'][k]])['SecurityGroups'][0]['IpPermissionsEgress']: bad.append(f'sg {k} egress')\ne = ec2.describe_security_groups(GroupIds=[m['network']['security_group_ids']['alb']])['SecurityGroups'][0]['IpPermissionsEgress']\nif len(e) != 1 or e[0].get('FromPort') != 8080: bad.append(f'alb egress {e}')\nprint('OK' if not bad else 'FAIL:\\n  ' + '\\n  '.join(bad))\nEOF" action.permission=* action.action=allow action.pattern=*
