timestamp=2026-10-10T05:55:42.816Z level=INFO run=5f6a65af message=evaluated permission=bash pattern="cat > /tmp/w/drill.sh <<'EOF'\n#!/bin/bash\n# Drift drill\nset -x\nA=\"aws --endpoint-url http://aws:4566\"\nM=/workspace/submission/manifest.json\nP=$(jq -r .resource_prefix $M)\nQ=$(jq -r .messaging.queue_url $M); DQ=$(jq -r .messaging.dlq_url $M)\nB=$(jq -r .audit.bucket_name $M); T=$(jq -r .projections.table_name $M)\n# IAM\n$A iam put-role-policy --role-name $P-projector --policy-name breakglass --policy-document '{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}]}'\nARN=$($A iam create-policy --policy-name $P-oob --policy-document '{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sqs:*\",\"Resource\":\"*\"}]}' --query Policy.Arn --output text)\n$A iam create-policy-version --policy-arn $ARN --set-as-default --policy-document '{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sqs:SendMessage\",\"Resource\":\"*\"}]}' >/dev/null\n$A iam attach-role-policy --role-name $P-outbox-relay --policy-arn $ARN\nARN2=$($A iam create-policy --policy-name $P-detached --policy-document '{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sqs:*\",\"Resource\":\"*\"}]}' --query Policy.Arn --output text)\n# SG\nfor k in rds valkey alb; do $A ec2 authorize-security-group-egress --group-id $(jq -r .network.security_group_ids.$k $M) --ip-permissions 'IpProtocol=-1,IpRanges=[{CidrIp=0.0.0.0/0}]'; done\n# SQS\n$A sqs set-queue-attributes --queue-url $Q --attributes VisibilityTimeout=30\n$A sqs set-queue-attributes --queue-url $DQ --attributes MessageRetentionPeriod=60\n# Schedules\n$A scheduler update-schedule --name $P-outbox-relay --schedule-expression 'rate(10 minutes)' --flexible-time-window Mode=OFF --target \"{\\\"Arn\\\":\\\"$(jq -r .workers.outbox_relay.function_arn $M)\\\",\\\"RoleArn\\\":\\\"$(jq -r .iam.scheduler_role_arn $M)\\\"}\" --state DISABLED\n# Logs\n$A logs put-retention-policy --log-group-name $(jq -r .logs.api_log_group $M) --retention-in-days 1\n# Lambda env\n$A lambda update-function-configuration --function-name $P-outbox-relay --environment 'Variables={OUTBOX_BATCH_SIZE=5}' >/dev/null\n# ESM\n$A lambda update-event-source-mapping --uuid $(jq -r .messaging.event_source_mapping_uuid $M) --no-enabled >/dev/null\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-10-10T05:55:42.816Z level=INFO run=5f6a65af message=evaluated permission=bash pattern="cat > /tmp/w/drill_data.sh <<'EOF'\n#!/bin/bash\nset -x\nA=\"aws --endpoint-url http://aws:4566\"\nM=/workspace/submission/manifest.json\nB=$(jq -r .audit.bucket_name $M); T=$(jq -r .projections.table_name $M)\nexport PGPASSWORD=$(jq -r .db_password /workspace/config/config.json)\nP=\"psql -h aws -p 7001 -U clearledger -d clearledger -At\"\nSID=$($P -c \"select settlement_id from clearledger.settlements order by created_at limit 1\")\n# DynamoDB\n$A dynamodb put-item --table-name $T --item '{\"PK\":{\"S\":\"SETTLEMENT#00000000-0000-0000-0000-000000000000\"},\"SK\":{\"S\":\"STATE\"},\"status\":{\"S\":\"X\"}}'\n$A dynamodb put-item --table-name $T --item \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID\\\"},\\\"SK\\\":{\\\"S\\\":\\\"EVENT#00000099\\\"}}\"\n$A dynamodb update-item --table-name $T --key \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID\\\"},\\\"SK\\\":{\\\"S\\\":\\\"STATE\\\"}}\" --update-expression 'SET #s = :s, GSI1PK = :g' --expression-attribute-names '{\"#s\":\"status\"}' --expression-attribute-values '{\":s\":{\"S\":\"BOGUS\"},\":g\":{\"S\":\"ACCOUNT#nope\"}}'\n$A dynamodb delete-item --table-name $T --key \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID\\\"},\\\"SK\\\":{\\\"S\\\":\\\"EVENT#00000001\\\"}}\"\n# Valkey\npython3 - <<'PY'\nimport socket\ns=socket.create_connection((\"aws\",6379))\ndef c(*a):\n    s.sendall(b\"*%d\\r\\n\"%len(a)+b\"\".join(b\"$%d\\r\\n%s\\r\\n\"%(len(x.encode()),x.encode()) for x in a)); return s.recv(65536)\nprint(c(\"SET\",\"stray:key\",\"1\")); print(c(\"SET\",\"clearledger:settlement:00000000-0000-0000-0000-000000000000\",\"{}\")); print(c(\"SET\",\"clearledger:other\",\"x\"))\nPY\n# S3\necho junk > /tmp/w/junk.txt\n$A s3 cp /tmp/w/junk.txt s3://$B/stray/junk.txt\n$A s3 cp /tmp/w/junk.txt s3://$B/ledger-audit/batch-00000001-00000002-0000000000000000.ndjson\nK=$($A s3api list-objects-v2 --bucket $B --prefix ledger-audit/batch-00000001 --query 'Contents[0].Key' --output text)\n$A s3 cp /tmp/w/junk.txt s3://$B/$K\nK2=$($A s3api list-objects-v2 --bucket $B --prefix ledger-audit/batch-00000006 --query 'Contents[0].Key' --output text)\n$A s3 rm s3://$B/$K2\n# PG replay reset\n$P -c \"update clearledger.outbox set published_at = null, archived_at = null where seq in (3,4)\"\nEOF" action.permission=* action.action=allow action.pattern=*
