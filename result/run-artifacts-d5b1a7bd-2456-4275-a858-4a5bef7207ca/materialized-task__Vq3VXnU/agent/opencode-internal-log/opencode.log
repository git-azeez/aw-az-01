timestamp=2026-10-09T19:13:47.420Z level=INFO run=9ec7d900 message=evaluated permission=bash pattern="cat > /tmp/work/verify.py <<'EOF'\nimport sys, json, hashlib, re\nsys.path.insert(0,'/workspace/submission/infra/scripts')\nimport clearledger_ops as ops\nctx=ops.Ctx('/workspace/submission/manifest.json','/workspace/config/config.json')\nok=True\ndef bad(m):\n    global ok; ok=False; print('FAIL', m)\n# outbox\nr=ctx.pg.json(\"select count(*) filter (where published_at is null) unpub, count(*) filter (where archived_at is null) unarch, count(*) n from clearledger.outbox\")[0]\nprint('outbox', r)\nif r['unpub'] or r['unarch']: bad('outbox not fully published/archived')\n# dynamo\ns,e=ops.load_pg_state(ctx)\nexp=ops.expected_items(s,e)\nact={(i['PK']['S'],i['SK']['S']):i for i in ops.scan_table(ctx.aws('dynamodb'),ctx.m['projections']['table_name'])}\nfor k in set(act)-set(exp): bad(f'extra item {k}')\nfor k in set(exp)-set(act): bad(f'missing item {k}')\nfor k in set(exp)&set(act):\n    if not ops.items_equal(act[k],exp[k]): bad(f'diff {k}: {act[k]} vs {exp[k]}')\n# valkey\nrr=ops.Resp(ctx.m['cache']['endpoint'],ctx.m['cache']['port'])\nkeys=rr.cmd('KEYS','clearledger:*')\nsm={x['settlement_id']:x for x in s}\nfor k in keys:\n    k=k.decode(); sid=k.split(':')[-1]\n    ttl=rr.cmd('TTL',k)\n    if sid not in sm: bad(f'orphan key {k}'); continue\n    if not (0<ttl<=90): bad(f'ttl {k} {ttl}')\n    if not ops.projection_matches(rr.cmd('GET',k), ops.expected_projection(sm[sid])): bad(f'divergent {k}')\nprint('valkey keys', len(keys))\n# s3\ns3=ctx.aws('s3'); b=ctx.m['audit']['bucket_name']\nvs,ms=ops.list_versions(s3,b)\nif ms: bad(f'delete markers {len(ms)}')\nif any(not v['IsLatest'] for v in vs): bad('noncurrent versions')\nob=ctx.pg.json(\"select seq, event_id::text event_id, payload from clearledger.outbox\")\nbe={x['event_id']:x for x in ob}\nseen={}\nfor v in vs:\n    body=s3.get_object(Bucket=b,Key=v['Key'])['Body'].read()\n    seqs=ops.validate_batch(v['Key'],body,be)\n    if seqs is None: bad(f'invalid batch {v[\"Key\"]}'); continue\n    for q in seqs:\n        if q in seen: bad(f'dup seq {q}')\n        seen[q]=v['Key']\nif set(seen)!=set(x['seq'] for x in ob): bad(f'coverage mismatch {len(seen)} vs {len(ob)}')\nprint('s3 objects', len(vs), 'events covered', len(seen))\nprint('OK' if ok else 'NOT OK')\nEOF" action.permission=* action.action=allow action.pattern=*
