timestamp=2026-10-09T19:14:05.343Z level=INFO run=9ec7d900 message=evaluated permission=bash pattern="cat > /tmp/work/drill.sh <<'EOF'\nset -x\nE=\"--endpoint-url http://aws:4566\"; M=/workspace/submission/manifest.json\nT=$(jq -r .projections.table_name $M); B=$(jq -r .audit.bucket_name $M)\nSID=$(jq -r '.[0]' /tmp/work/sids.json); SID2=$(jq -r '.[1]' /tmp/work/sids.json)\nexport PGPASSWORD='Cla59b606b47!'\n# dynamo: orphan partition, stray SK, wrong attr, missing event, extra attr\naws $E dynamodb put-item --table-name $T --item '{\"PK\":{\"S\":\"SETTLEMENT#00000000-0000-0000-0000-000000000001\"},\"SK\":{\"S\":\"STATE\"},\"GSI1PK\":{\"S\":\"ACCOUNT#X\"},\"GSI1SK\":{\"S\":\"SETTLEMENT#00000000-0000-0000-0000-000000000001\"},\"version\":{\"N\":\"1\"}}'\naws $E dynamodb put-item --table-name $T --item \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID\\\"},\\\"SK\\\":{\\\"S\\\":\\\"EVENT#00000099\\\"}}\"\naws $E dynamodb put-item --table-name $T --item \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID\\\"},\\\"SK\\\":{\\\"S\\\":\\\"JUNK\\\"}}\"\naws $E dynamodb update-item --table-name $T --key \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID2\\\"},\\\"SK\\\":{\\\"S\\\":\\\"STATE\\\"}}\" --update-expression 'SET #s = :s, GSI1PK = :g, version = :v, extra = :s' --expression-attribute-names '{\"#s\":\"status\"}' --expression-attribute-values '{\":s\":{\"S\":\"BOGUS\"},\":g\":{\"S\":\"ACCOUNT#WRONG\"},\":v\":{\"N\":\"77\"}}'\naws $E dynamodb delete-item --table-name $T --key \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID2\\\"},\\\"SK\\\":{\\\"S\\\":\\\"EVENT#00000001\\\"}}\"\naws $E dynamodb update-item --table-name $T --key \"{\\\"PK\\\":{\\\"S\\\":\\\"SETTLEMENT#$SID\\\"},\\\"SK\\\":{\\\"S\\\":\\\"EVENT#00000002\\\"}}\" --update-expression 'SET memo = :m' --expression-attribute-values '{\":m\":{\"S\":\"tampered\"}}'\n# valkey\npython3 /tmp/work/resp.py SET clearledger:settlement:00000000-0000-0000-0000-000000000002 '{}' EX 60\npython3 /tmp/work/resp.py SET clearledger:settlement:$SID '{\"settlementId\":\"x\"}'\npython3 /tmp/work/resp.py SET clearledger:settlement:$SID2 '{\"bogus\":1}' EX 500\npython3 /tmp/work/resp.py SET clearledger:junk 1\n# s3\necho hello | aws $E s3 cp - s3://$B/stray/object.txt\necho hello | aws $E s3 cp - s3://$B/ledger-audit/batch-00000001-00000001-0000000000000000.ndjson\nK=$(aws $E s3api list-objects-v2 --bucket $B --prefix ledger-audit/batch-00000001-00000003 | jq -r '.Contents[0].Key')\naws $E s3api get-object --bucket $B --key $K /tmp/work/b.ndjson >/dev/null; aws $E s3api put-object --bucket $B --key $K --body /tmp/work/b.ndjson >/dev/null\naws $E s3api put-object --bucket $B --key ledger-audit/copy-of-batch.ndjson --body /tmp/work/b.ndjson >/dev/null\naws $E s3 rm s3://$B/ledger-audit/copy-of-batch.ndjson\n# duplicate valid batch: same events with seq 1..1 only\nhead -1 /tmp/work/b.ndjson > /tmp/work/b1.ndjson; H=$(sha256sum /tmp/work/b1.ndjson | cut -c1-16)\naws $E s3api put-object --bucket $B --key ledger-audit/batch-00000001-00000001-$H.ndjson --body /tmp/work/b1.ndjson >/dev/null\n# outbox replay reset\npsql -h aws -p 7001 -U clearledger -d clearledger -c \"update clearledger.outbox set published_at=NULL, archived_at=NULL where seq in (5,6,7)\"\n# control plane: delete queue + esm drift\naws $E sqs delete-queue --queue-url $(jq -r .messaging.queue_url $M)\naws $E logs put-retention-policy --log-group-name /clearledger/cl-9b11b1/projector --retention-in-days 3\naws $E iam put-role-policy --role-name cl-9b11b1-scheduler --policy-name oob --policy-document '{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":\"*\"}]}'\naws $E ec2 authorize-security-group-egress --group-id $(jq -r .network.security_group_ids.valkey $M) --ip-permissions 'IpProtocol=-1,IpRanges=[{CidrIp=0.0.0.0/0}]' >/dev/null\nEOF" action.permission=* action.action=allow action.pattern=*
