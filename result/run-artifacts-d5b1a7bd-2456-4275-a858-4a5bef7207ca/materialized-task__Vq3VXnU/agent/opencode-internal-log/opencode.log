timestamp=2026-10-09T19:13:12.246Z level=INFO run=9ec7d900 message=evaluated permission=bash pattern="cat > /tmp/work/traffic.py <<'EOF'\nimport json, urllib.request, uuid, sys, random, datetime, base64\nM=json.load(open('/workspace/submission/manifest.json'))\nU=M['service_url']\ndef token(c):\n    cl=M['auth']['clients'][c]\n    req=urllib.request.Request(M['auth']['token_endpoint'],data=f\"grant_type=client_credentials&scope={cl['scope']}\".encode(),\n        headers={'Authorization':'Basic '+base64.b64encode(f\"{cl['client_id']}:{cl['client_secret']}\".encode()).decode(),'Content-Type':'application/x-www-form-urlencoded'})\n    return json.load(urllib.request.urlopen(req))['access_token']\nT={c:token(c) for c in ['read','write','admin']}\ndef call(method,path,tok,body=None,headers={}):\n    h={'Authorization':'Bearer '+tok,'Content-Type':'application/json','X-Correlation-Id':'corr-'+uuid.uuid4().hex[:8]}\n    h.update(headers)\n    req=urllib.request.Request(U+path,method=method,data=json.dumps(body).encode() if body is not None else None,headers=h)\n    try:\n        r=urllib.request.urlopen(req); return r.status, r.read().decode(), dict(r.headers)\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode(), dict(e.headers)\nn=int(sys.argv[1]) if len(sys.argv)>1 else 3\nflow=['VALIDATED','RESERVED','CLEARED','SETTLED','RECONCILED']\nsids=[]\nt0=datetime.datetime.now(datetime.timezone.utc)\nfor i in range(n):\n    sid=str(uuid.uuid4()); sids.append(sid)\n    st=call('POST','/v1/settlements',T['write'],{'settlementId':sid,'accountId':f'ACC-{i%3:03d}','reference':f'REF-{i:05d}','debitParty':'BANK-A','creditParty':'BANK-B','expectedVersion':0},{'Idempotency-Key':'create-'+sid})\n    assert st[0]==201, st\n    k=random.randint(1,5)\n    for j in range(k):\n        ts=(t0+datetime.timedelta(seconds=j+1)).isoformat().replace('+00:00','Z')\n        body={'entryId':str(uuid.uuid4()),'status':flow[j],'clearingStage':f'STAGE-{j}','occurredAt':ts,'expectedVersion':j+1}\n        if j%2==0: body['memo']=f'memo {j}'\n        st=call('POST',f'/v1/settlements/{sid}/entries',T['write'],body,{'Idempotency-Key':f'entry-{sid[:8]}-{j:04d}'})\n        assert st[0]==202, st\nprint(json.dumps(sids))\nEOF" action.permission=* action.action=allow action.pattern=*
