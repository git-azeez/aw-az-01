timestamp=2026-10-10T19:11:27.863Z level=INFO run=1ae05b66 message=evaluated permission=bash pattern="cat > /tmp/cl/api.py <<'EOF'\nimport json, sys, uuid, urllib.request, base64, urllib.parse, datetime\nM = json.load(open('/tmp/cl/m.json'))\nBASE = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1].startswith('http') else 'http://aws:80'\ndef token(kind):\n    c = M['auth']['clients'][kind]\n    req = urllib.request.Request(M['auth']['token_endpoint'], data=urllib.parse.urlencode({'grant_type':'client_credentials','scope':c['scope']}).encode(),\n        headers={'Authorization':'Basic '+base64.b64encode(f\"{c['client_id']}:{c['client_secret']}\".encode()).decode(),'Content-Type':'application/x-www-form-urlencoded'})\n    return json.load(urllib.request.urlopen(req))['access_token']\nT = {k: token(k) for k in ('read','write','admin')}\ndef call(method, path, body=None, kind='read', headers=None):\n    h = {'Authorization': 'Bearer '+T[kind], 'Content-Type':'application/json', 'X-Correlation-Id': 'corr-'+uuid.uuid4().hex[:8]}\n    h.update(headers or {})\n    req = urllib.request.Request(BASE+path, data=json.dumps(body).encode() if body is not None else None, method=method, headers=h)\n    try:\n        r = urllib.request.urlopen(req); return r.status, dict(r.headers), r.read().decode()\n    except urllib.error.HTTPError as e:\n        return e.code, dict(e.headers), e.read().decode()\nEOF" action.permission=* action.action=allow action.pattern=*
