timestamp=2026-10-10T09:09:53.093Z level=INFO run=bae7fc94 message=evaluated permission=bash pattern="cat > /tmp/drift2.py <<'EOF'\nimport boto3, json, redis, uuid, psycopg2\nm=json.load(open('/workspace/submission/manifest.json')); cfg=json.load(open('/workspace/config/config.json'))\nkw=dict(endpoint_url='http://aws:4566',region_name='us-east-1',aws_access_key_id='test',aws_secret_access_key='test')\nddb=boto3.client('dynamodb',**kw); T=m['projections']['table_name']\nitems=ddb.scan(TableName=T)['Items']\nstates=[i for i in items if i['SK']['S']=='STATE']\nddb.delete_item(TableName=T,Key={'PK':states[0]['PK'],'SK':states[0]['SK']})\nev=[i for i in items if i['SK']['S']=='EVENT#00000002'][0]\nddb.delete_item(TableName=T,Key={'PK':ev['PK'],'SK':ev['SK']})\nddb.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#'+str(uuid.uuid4())},'SK':{'S':'STATE'},'version':{'N':'9'}})\nddb.put_item(TableName=T,Item={'PK':states[1]['PK'],'SK':{'S':'EVENT#00000099'},'version':{'N':'99'}})\nddb.update_item(TableName=T,Key={'PK':states[2]['PK'],'SK':states[2]['SK']},UpdateExpression='SET #s=:v, extra=:e',ExpressionAttributeNames={'#s':'status'},ExpressionAttributeValues={':v':{'S':'SETTLED'},':e':{'S':'x'}})\nr=redis.Redis(host='aws',port=6379,decode_responses=True)\nr.set('clearledger:settlement:'+str(uuid.uuid4()),'{}',ex=50); r.set('foo','bar')\nks=r.keys('clearledger:settlement:*'); r.delete(ks[0]); r.set(ks[1],'{\"bad\":1}',ex=500)\ns3=boto3.client('s3',**kw,config=boto3.session.Config(s3={'addressing_style':'path'})); B=m['audit']['bucket_name']\ns3.put_object(Bucket=B,Key='ledger-audit/garbage.txt',Body=b'x'); s3.put_object(Bucket=B,Key='other/x',Body=b'y')\ns3.put_object(Bucket=B,Key='ledger-audit/batch-00000100-00000100-0123456789abcdef.ndjson',Body=b'{}\\n')\nk=[o['Key'] for o in s3.list_objects_v2(Bucket=B,Prefix='ledger-audit/batch')['Contents'] if '00000001-' in o['Key']][0]\ns3.delete_object(Bucket=B,Key=k)\nc=psycopg2.connect(host='aws',port=7001,dbname=cfg['db_name'],user=cfg['db_username'],password=cfg['db_password']); c.autocommit=True; cur=c.cursor()\ncur.execute(\"ALTER TABLE clearledger.settlements DISABLE TRIGGER ALL\")\ncur.execute(\"ALTER TABLE clearledger.outbox DISABLE TRIGGER USER\")\ncur.execute(\"ALTER TABLE clearledger.events DROP CONSTRAINT events_envelope_chk\")\ncur.execute(\"DROP INDEX clearledger.idx_clearledger_outbox_unarchived\")\ncur.execute(\"DROP TRIGGER trg_idempotency_immutable ON clearledger.idempotency_keys\")\ncur.execute(\"UPDATE clearledger.outbox SET published_at=NULL, archived_at=NULL WHERE seq IN (10,11,12)\")\ncur.execute(\"UPDATE clearledger.outbox SET archived_at=NULL WHERE seq IN (14,15)\")\ncur.execute(\"ALTER TABLE clearledger.outbox ENABLE TRIGGER USER\")\ncur.execute(\"select seq,published_at is not null,archived_at is not null from clearledger.outbox order by seq\")\nprint(cur.fetchall())\nsq=boto3.client('sqs',**kw); sq.delete_queue(QueueUrl=m['messaging']['queue_url'])\nEOF" action.permission=* action.action=allow action.pattern=*
