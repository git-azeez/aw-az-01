ambda:[f['UUID'] for f in c('lambda').list_event_source_mappings()['EventSourceMappings']])\nsafe('logs',lambda:[g['logGroupName'] for g in c('logs').describe_log_groups()['logGroups']])\nsafe('sched',lambda:[s['Name'] for s in c('scheduler').list_schedules()['Schedules']])\nsafe('schedgroups',lambda:[s['Name'] for s in c('scheduler').list_schedule_groups()['ScheduleGroups']])\nsafe('ecs',lambda:c('ecs').list_clusters()['clusterArns'])\nsafe('taskdefs',lambda:c('ecs').list_task_definitions()['taskDefinitionArns'])\nsafe('taskdef_families',lambda:c('ecs').list_task_definition_families(status='ALL')['families'])\nsafe('elb',lambda:[l['LoadBalancerName'] for l in c('elbv2').describe_load_balancers()['LoadBalancers']])\nsafe('tg',lambda:[l['TargetGroupName'] for l in c('elbv2').describe_target_groups()['TargetGroups']])\nsafe('rds',lambda:[d['DBInstanceIdentifier'] for d in c('rds').describe_db_instances()['DBInstances']])\nsafe('rdssg',lambda:[d['DBSubnetGroupName'] for d in c('rds').describe_db_subnet_groups()['DBSubnetGroups']])\nsafe('ecrg',lambda:[d['ReplicationGroupId'] for d in c('elasticache').describe_replication_groups()['ReplicationGroups']])\nsafe('eccl',lambda:[d['CacheClusterId'] for d in c('elasticache').describe_cache_clusters()['CacheClusters']])\nsafe('ecsubnet',lambda:[d['CacheSubnetGroupName'] for d in c('elasticache').describe_cache_subnet_groups()['CacheSubnetGroups']])\nsafe('cognito',lambda:[d['Name'] for d in c('cognito-idp').list_user_pools(MaxResults=60)['UserPools']])\njson.dump(out,open(sys.argv[1],'w'),indent=1,sort_keys=True)\nEOF" action.permission=* action.action=allow action.pattern=*
