timestamp=2026-10-10T05:49:27.925Z level=INFO run=4ace79d1 message=evaluated permission=bash pattern="cat > /tmp/drill2.py <<'EOF'\nimport boto3, json, uuid, redis, psycopg2\nE='http://aws:4566'\ndef c(n): return boto3.client(n,endpoint_url=E,region_name='us-east-1',aws_access_key_id='test',aws_secret_access_key='test')\nM=json.load(open('/workspace/submission/manifest.json'))\ns3=c('s3'); B=M['audit']['bucket_name']\nT=M['projections']['table_name']; ddb=c('dynamodb')\nsid=open('/tmp/sid1').read().strip()\n# DDB: orphan partition, stray SK, divergent attribute, missing event, bad GSI\nddb.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#'+str(uuid.uuid4())},'SK':{'S':'STATE'},'version':{'N':'9'}})\nddb.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#'+sid},'SK':{'S':'EVENT#00000099'},'x':{'S':'y'}})\nddb.update_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+sid},'SK':{'S':'STATE'}},UpdateExpression='SET last_memo=:m, GSI1PK=:g',ExpressionAttributeValues={':m':{'S':'tampered'},':g':{'S':'ACCOUNT#nope'}})\nddb.delete_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+sid},'SK':{'S':'EVENT#00000002'}})\n# Valkey strays\nr=redis.Redis(host='aws',port=6379)\nr.set('clearledger:settlement:'+str(uuid.uuid4()),'{}',ex=50); r.set('other:key','1'); r.set('clearledger:settlement:'+sid,'garbage',ex=500)\n# S3: stray object, delete marker, extra versions, tamper\ns3.put_object(Bucket=B,Key='junk/file.txt',Body=b'x')\ns3.put_object(Bucket=B,Key='ledger-audit/batch-00000001-00000002-deadbeefdeadbeef.ndjson',Body=b'{\"a\":1}\\n')\nkeys=[o['Key'] for o in s3.list_objects_v2(Bucket=B,Prefix='ledger-audit/batch-00000007')['Contents']]\nfor k in keys:\n    b=s3.get_object(Bucket=B,Key=k)['Body'].read(); s3.put_object(Bucket=B,Key=k,Body=b); s3.put_object(Bucket=B,Key=k,Body=b)\ns3.delete_object(Bucket=B,Key=keys[0])\n# Outbox: unpublish last two rows (operational replay reset)\ndb=M['database']; conn=psycopg2.connect(host=db['endpoint'],port=db['port'],dbname=db['db_name'],user='clearledger',password='Cld430f54363!'); conn.autocommit=True\ncur=conn.cursor(); cur.execute(\"update clearledger.outbox set published_at=NULL, archived_at=NULL where seq>=6\"); print(cur.rowcount)\nprint('data drift injected')\nEOF" action.permission=* action.action=allow action.pattern=*
