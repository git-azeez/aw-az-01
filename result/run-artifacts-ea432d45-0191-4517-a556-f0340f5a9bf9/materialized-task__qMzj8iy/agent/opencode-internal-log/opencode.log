g_group'],retentionInDays=1)\n# lambda env\nfn=M['workers']['outbox_relay']['function_name']\nenv=lam.get_function_configuration(FunctionName=fn)['Environment']['Variables']; env['OUTBOX_BATCH_SIZE']='1'\nlam.update_function_configuration(FunctionName=fn,Environment={'Variables':env})\n# schedule\ns=sch.get_schedule(Name=M['schedules']['outbox_schedule_name'])\nsch.update_schedule(Name=s['Name'],ScheduleExpression='rate(30 minutes)',FlexibleTimeWindow=s['FlexibleTimeWindow'],Target=s['Target'],State='DISABLED')\nprint('drift injected')\nEOF" action.permission=* action.action=allow action.pattern=*
