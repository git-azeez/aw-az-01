timestamp=2026-10-10T19:18:26.490Z level=INFO run=dea545bd message=evaluated permission=bash pattern="python3 - <<'E'\nimport boto3\ne=boto3.client('ec2',endpoint_url='http://aws:4566',region_name='us-east-1')\nimport json; m=json.load(open('/tmp/w/m.json'))['network']['security_group_ids']\ne.authorize_security_group_ingress(GroupId=m['ecs'],IpPermissions=[{'IpProtocol':'tcp','FromPort':22,'ToPort':22,'IpRanges':[{'CidrIp':'10.0.0.0/8'}]}])\ne.authorize_security_group_ingress(GroupId=m['rds'],IpPermissions=[{'IpProtocol':'tcp','FromPort':5432,'ToPort':5432,'IpRanges':[{'CidrIp':'0.0.0.0/0'}]}])\ne.authorize_security_group_egress(GroupId=m['alb'],IpPermissions=[{'IpProtocol':'tcp','FromPort':443,'ToPort':443,'IpRanges':[{'CidrIp':'0.0.0.0/0'}]}])\ne.authorize_security_group_egress(GroupId=m['valkey'],IpPermissions=[{'IpProtocol':'tcp','FromPort':443,'ToPort':443,'IpRanges':[{'CidrIp':'0.0.0.0/0'}]}])\nE" action.permission=* action.action=allow action.pattern=*
