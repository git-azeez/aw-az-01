timestamp=2026-10-10T19:19:05.455Z level=INFO run=dea545bd message=evaluated permission=bash pattern="cat > drift.py <<'E'\nimport boto3,json,redis\nd=boto3.client('dynamodb',endpoint_url='http://aws:4566',region_name='us-east-1')\ns3=boto3.client('s3',endpoint_url='http://aws:4566',region_name='us-east-1')\nT='cl-d81788-projections'; B='cl-d81788-audit'\nS='070217c4-7335-4055-aa12-49e179291460'\nsnap={}\nfor it in d.scan(TableName=T)['Items']: snap[(it['PK']['S'],it['SK']['S'])]=it\njson.dump({f\"{k[0]}|{k[1]}\":v for k,v in snap.items()},open('ddb_snap.json','w'),sort_keys=True)\n# drift\nd.delete_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+S},'SK':{'S':'EVENT#00000003'}})\nd.update_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+S},'SK':{'S':'STATE'}},UpdateExpression='SET #s=:x, version=:v, bogus=:b',ExpressionAttributeNames={'#s':'status'},ExpressionAttributeValues={':x':{'S':'CLEARED'},':v':{'N':'99'},':b':{'S':'x'}})\nd.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#'+S},'SK':{'S':'EVENT#00000042'},'x':{'S':'y'}})\nd.put_item(TableName=T,Item={'PK':{'S':'SETTLEMENT#deadbeef'},'SK':{'S':'STATE'},'GSI1PK':{'S':'ACCOUNT#z'},'GSI1SK':{'S':'SETTLEMENT#deadbeef'}})\nd.update_item(TableName=T,Key={'PK':{'S':'SETTLEMENT#'+S},'SK':{'S':'EVENT#00000002'}},UpdateExpression='SET memo=:m',ExpressionAttributeValues={':m':{'S':'tampered'}})\n# s3\nk='ledger-audit/batch-00000001-00000006-f17b214e580f74e6.ndjson'\nbody=s3.get_object(Bucket=B,Key=k)['Body'].read()\ns3.put_object(Bucket=B,Key='junk.txt',Body=b'x')\ns3.put_object(Bucket=B,Key='ledger-audit/notes.txt',Body=b'x')\ns3.put_object(Bucket=B,Key='ledger-audit/batch-00000001-00000003-aaaaaaaaaaaaaaaa.ndjson',Body=b'bad\\n')\ns3.put_object(Bucket=B,Key=k,Body=body)   # noncurrent version of valid\ns3.put_object(Bucket=B,Key='ledger-audit/batch-00000007-00000009-0123456789abcdef.ndjson',Body=b'z\\n')\ns3.delete_object(Bucket=B,Key='junk.txt')  # delete marker\n# valkey\nr=redis.Redis(host='aws',port=6379)\nr.set('foo','bar'); r.set('clearledger:settlement:nope','{}',ex=50); r.set('clearledger:settlement:'+S,'{\"stale\":1}',ex=50)\nE" action.permission=* action.action=allow action.pattern=*
