timestamp=2026-10-09T19:11:10.952Z level=INFO run=77c9387e message=evaluated permission=bash pattern="cat > /tmp/junk.py <<'EOF'\nimport boto3, json\nEP='http://aws:4566'; P='cl-8a2466'\ndef c(n): return boto3.client(n,endpoint_url=EP,region_name='us-east-1')\niam=c('iam'); \npol={'Version':'2012-10-17','Statement':[{'Effect':'Allow','Action':'s3:ListAllMyBuckets','Resource':'*'}]}\narn=iam.create_policy(PolicyName=f'{P}-oob-managed',PolicyDocument=json.dumps(pol))['Policy']['Arn']\nfor i in range(3):\n    iam.create_policy_version(PolicyArn=arn,PolicyDocument=json.dumps(pol),SetAsDefault=True)\ntrust={'Version':'2012-10-17','Statement':[{'Effect':'Allow','Principal':{'Service':'lambda.amazonaws.com'},'Action':'sts:AssumeRole'}]}\niam.create_role(RoleName=f'{P}-breakglass',AssumeRolePolicyDocument=json.dumps(trust))\niam.attach_role_policy(RoleName=f'{P}-breakglass',PolicyArn=arn)\niam.put_role_policy(RoleName=f'{P}-breakglass',PolicyName='bg',PolicyDocument=json.dumps(pol))\nfor r in ['relay','ecs-task']:\n    iam.put_role_policy(RoleName=f'{P}-{r}',PolicyName='oob-inline',PolicyDocument=json.dumps(pol))\niam.attach_role_policy(RoleName=f'{P}-projector',PolicyArn=arn)\niam.attach_role_policy(RoleName=f'{P}-archiver',PolicyArn='arn:aws:iam::aws:policy/AmazonS3FullAccess') if False else None\nc('sqs').create_queue(QueueName=f'{P}-oob-queue')\ns3=c('s3'); s3.create_bucket(Bucket=f'{P}-oob-bucket'); s3.put_bucket_versioning(Bucket=f'{P}-oob-bucket',VersioningConfiguration={'Status':'Enabled'})\nfor i in range(3): s3.put_object(Bucket=f'{P}-oob-bucket',Key='a',Body=b'x%d'%i)\ns3.delete_object(Bucket=f'{P}-oob-bucket',Key='a')\nc('dynamodb').create_table(TableName=f'{P}-oob-table',AttributeDefinitions=[{'AttributeName':'a','AttributeType':'S'}],KeySchema=[{'AttributeName':'a','KeyType':'HASH'}],BillingMode='PAY_PER_REQUEST')\nk=c('kms').create_key(Tags=[{'TagKey':'ClearLedgerDeployment','TagValue':P}])['KeyMetadata']['KeyId']\nc('kms').create_alias(AliasName=f'alias/{P}-oob',TargetKeyId=k)\nc('logs').create_log_group(logGroupName=f'/clearledger/{P}/oob')\nc('scheduler').create_schedule(Name=f'{P}-oob-sched',ScheduleExpression='rate(1 hour)',FlexibleTimeWindow={'Mode':'OFF'},Target={'Arn':f'arn:aws:lambda:us-east-1:000000000000:function:{P}-outbox-relay','RoleArn':f'arn:aws:iam::000000000000:role/{P}-scheduler'})\n# a baseline resource that must survive\niam.create_role(RoleName='cl-base-keepme',AssumeRolePolicyDocument=json.dumps(trust))\nc('sqs').create_queue(QueueName='cl-base-queue')\nprint('junk created')\nEOF" action.permission=* action.action=allow action.pattern=*
