timestamp=2026-10-10T20:00:37.331Z level=INFO run=25e2b238 message=evaluated permission=bash pattern="cat > locals.tf <<'EOF'\ndata \"aws_caller_identity\" \"current\" {}\n\nlocals {\n  config = jsondecode(file(var.config_path))\n\n  prefix     = local.config.resource_prefix\n  region     = local.config.region\n  endpoint   = local.config.aws_endpoint_url\n  account_id = data.aws_caller_identity.current.account_id\n\n  tags = {\n    ClearLedgerDeployment = local.prefix\n  }\n\n  azs = [\"us-east-1a\", \"us-east-1b\"]\n\n  vpc_cidr             = \"10.42.0.0/16\"\n  public_subnet_cidrs  = [\"10.42.0.0/24\", \"10.42.1.0/24\"]\n  private_subnet_cidrs = [\"10.42.10.0/24\", \"10.42.11.0/24\"]\n\n  # Runtime constants from contracts/runtime.md\n  cache_ttl_seconds = \"90\"\n  outbox_batch_size = \"50\"\n  audit_prefix      = \"ledger-audit/\"\n\n  database_url = \"postgres://${local.config.db_username}:${local.config.db_password}@${aws_db_instance.main.address}:${aws_db_instance.main.port}/${local.config.db_name}\"\n  valkey_url   = \"redis://${aws_elasticache_replication_group.valkey.primary_endpoint_address}:${aws_elasticache_replication_group.valkey.port}\"\n\n  issuer_url     = \"${local.endpoint}/${aws_cognito_user_pool.main.id}\"\n  jwks_url       = \"${local.endpoint}/${aws_cognito_user_pool.main.id}/.well-known/jwks.json\"\n  token_endpoint = \"${local.endpoint}/cognito-idp/oauth2/token\"\n  auth_audiences = join(\",\", [\n    aws_cognito_user_pool_client.read.id,\n    aws_cognito_user_pool_client.write.id,\n    aws_cognito_user_pool_client.admin.id,\n  ])\n}\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-10-10T20:00:37.331Z level=INFO run=25e2b238 message=evaluated permission=bash pattern="cat > network.tf <<'EOF'\nresource \"aws_vpc\" \"main\" {\n  cidr_block           = local.vpc_cidr\n  enable_dns_support   = true\n  enable_dns_hostnames = true\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-vpc\" })\n}\n\nresource \"aws_internet_gateway\" \"main\" {\n  vpc_id = aws_vpc.main.id\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-igw\" })\n}\n\nresource \"aws_subnet\" \"public\" {\n  count                   = 2\n  vpc_id                  = aws_vpc.main.id\n  cidr_block              = local.public_subnet_cidrs[count.index]\n  availability_zone       = local.azs[count.index]\n  map_public_ip_on_launch = true\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-public-${count.index}\", Tier = \"public\" })\n}\n\nresource \"aws_subnet\" \"private\" {\n  count                   = 2\n  vpc_id                  = aws_vpc.main.id\n  cidr_block              = local.private_subnet_cidrs[count.index]\n  availability_zone       = local.azs[count.index]\n  map_public_ip_on_launch = false\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-private-${count.index}\", Tier = \"private\" })\n}\n\nresource \"aws_route_table\" \"public\" {\n  vpc_id = aws_vpc.main.id\n\n  route {\n    cidr_block = \"0.0.0.0/0\"\n    gateway_id = aws_internet_gateway.main.id\n  }\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-public\" })\n}\n\nresource \"aws_route_table\" \"private\" {\n  vpc_id = aws_vpc.main.id\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-private\" })\n}\n\nresource \"aws_route_table_association\" \"public\" {\n  count          = 2\n  subnet_id      = aws_subnet.public[count.index].id\n  route_table_id = aws_route_table.public.id\n}\n\nresource \"aws_route_table_association\" \"private\" {\n  count          = 2\n  subnet_id      = aws_subnet.private[count.index].id\n  route_table_id = aws_route_table.private.id\n}\n\n# ---------------------------------------------------------------------------\n# Security groups. Rules are declared inline so that Terraform owns the full\n# rule set of every group and removes anything added out-of-band.\n# ---------------------------------------------------------------------------\n\nresource \"aws_security_group\" \"alb\" {\n  name        = \"${local.prefix}-alb\"\n  description = \"ClearLedger ALB: public HTTP in, API port out to the VPC\"\n  vpc_id      = aws_vpc.main.id\n\n  ingress {\n    description = \"HTTP from the internet\"\n    from_port   = 80\n    to_port     = 80\n    protocol    = \"tcp\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  egress {\n    description = \"API port to targets inside the VPC\"\n    from_port   = 8080\n    to_port     = 8080\n    protocol    = \"tcp\"\n    cidr_blocks = [local.vpc_cidr]\n  }\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-alb\" })\n}\n\nresource \"aws_security_group\" \"ecs\" {\n  name        = \"${local.prefix}-ecs\"\n  description = \"ClearLedger API tasks: 8080 from the ALB only\"\n  vpc_id      = aws_vpc.main.id\n\n  ingress {\n    description     = \"API port from the ALB security group\"\n    from_port       = 8080\n    to_port         = 8080\n    protocol        = \"tcp\"\n    security_groups = [aws_security_group.alb.id]\n  }\n\n  egress {\n    description = \"PostgreSQL inside the VPC\"\n    from_port   = 5432\n    to_port     = 5432\n    protocol    = \"tcp\"\n    cidr_blocks = [local.vpc_cidr]\n  }\n\n  egress {\n    description = \"Valkey inside the VPC\"\n    from_port   = 6379\n    to_port     = 6379\n    protocol    = \"tcp\"\n    cidr_blocks = [local.vpc_cidr]\n  }\n\n  egress {\n    description = \"AWS control plane (HTTPS)\"\n    from_port   = 443\n    to_port     = 443\n    protocol    = \"tcp\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  egress {\n    description = \"AWS control plane (local endpoint)\"\n    from_port   = 4566\n    to_port     = 4566\n    protocol    = \"tcp\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  egress {\n    description = \"DNS (UDP)\"\n    from_port   = 53\n    to_port     = 53\n    protocol    = \"udp\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  egress {\n    description = \"DNS (TCP)\"\n    from_port   = 53\n    to_port     = 53\n    protocol    = \"tcp\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-ecs\" })\n}\n\nresource \"aws_security_group\" \"rds\" {\n  name        = \"${local.prefix}-rds\"\n  description = \"ClearLedger PostgreSQL: 5432 from the API tasks only\"\n  vpc_id      = aws_vpc.main.id\n\n  ingress {\n    description     = \"PostgreSQL from the ECS security group\"\n    from_port       = 5432\n    to_port         = 5432\n    protocol        = \"tcp\"\n    security_groups = [aws_security_group.ecs.id]\n  }\n\n  egress = []\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-rds\" })\n}\n\nresource \"aws_security_group\" \"valkey\" {\n  name        = \"${local.prefix}-valkey\"\n  description = \"ClearLedger Valkey: 6379 from the API tasks only\"\n  vpc_id      = aws_vpc.main.id\n\n  ingress {\n    description     = \"Valkey from the ECS security group\"\n    from_port       = 6379\n    to_port         = 6379\n    protocol        = \"tcp\"\n    security_groups = [aws_security_group.ecs.id]\n  }\n\n  egress = []\n\n  tags = merge(local.tags, { Name = \"${local.prefix}-valkey\" })\n}\nEOF" action.permission=* action.action=allow action.pattern=*
