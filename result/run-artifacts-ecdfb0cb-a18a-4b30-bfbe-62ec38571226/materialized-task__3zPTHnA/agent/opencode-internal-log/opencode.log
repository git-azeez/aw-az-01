timestamp=2026-10-09T19:09:17.151Z level=INFO run=29ce22fa message=evaluated permission=bash pattern="cat > /tmp/load.py <<'EOF'\nimport json, time, uuid, sys, threading, urllib.request, urllib.error\ntok = json.load(open('/tmp/tok_write.json'))['access_token']\nstop = time.time() + float(sys.argv[1])\nstats = {}\nlock = threading.Lock()\ndef call(path, body, idem):\n    req = urllib.request.Request('http://aws:80'+path, data=json.dumps(body).encode(), method='POST',\n        headers={'Authorization':'Bearer '+tok,'Idempotency-Key':idem,'Content-Type':'application/json','X-Correlation-Id':'load-'+idem[-8:]})\n    try:\n        with urllib.request.urlopen(req, timeout=20) as r: return r.status\n    except urllib.error.HTTPError as e: return e.code\n    except Exception as e: return 'ERR'\ndef worker():\n    n=0\n    while time.time() < stop:\n        sid = str(uuid.uuid4())\n        s = call('/v1/settlements', {\"settlementId\":sid,\"accountId\":\"ACC-LOAD\",\"reference\":\"REF-LOAD\",\"debitParty\":\"BANK-X\",\"creditParty\":\"BANK-Y\",\"expectedVersion\":0}, 'idem-c-'+sid)\n        with lock: stats[('create',s)] = stats.get(('create',s),0)+1\n        for v,st in ((1,'VALIDATED'),(2,'RESERVED'),(3,'CLEARED')):\n            e=str(uuid.uuid4())\n            s = call(f'/v1/settlements/{sid}/entries', {\"entryId\":e,\"status\":st,\"clearingStage\":\"stage-\"+st.lower(),\"memo\":\"m\",\"occurredAt\":\"2026-10-09T19:00:00Z\",\"expectedVersion\":v}, 'idem-e-'+e)\n            with lock: stats[('entry',s)] = stats.get(('entry',s),0)+1\n        time.sleep(0.1)\nts=[threading.Thread(target=worker) for _ in range(4)]\n[t.start() for t in ts]; [t.join() for t in ts]\nprint(stats)\nEOF" action.permission=* action.action=allow action.pattern=*
