timestamp=2026-10-10T09:16:57.372Z level=INFO run=360dd8ab message=evaluated permission=bash pattern="python3 -c \"import operations as o; import json; m=o.manifest(); state=json.loads((o.ROOT/'infra/terraform.tfstate').read_text()); managed=[r for r in state['resources'] if r['mode']=='managed']; print('Managed resource instances:',sum(len(r['instances']) for r in managed)); print('Tagged resource instances:',sum(1 for r in managed for i in r['instances'] if i['attributes'].get('tags_all',{}).get('ClearLedgerDeployment')==o.P)); ecs=o.client('ecs'); tasks=ecs.list_tasks(cluster=m['compute']['cluster_name'])['taskArns']; desc=ecs.describe_tasks(cluster=m['compute']['cluster_name'],tasks=tasks)['tasks']; print('Running API tasks:',len(desc)); print('Availability zones:', sorted({t.get('availabilityZone','') for t in desc})); assert len(desc)==2; groups=o.client('ec2').describe_security_groups(GroupIds=list(m['network']['security_group_ids'].values()))['SecurityGroups']; assert all(not g['IpPermissionsEgress'] for g in groups if g['GroupName'].endswith(('-rds','-valkey'))); print('Manifest and networking validated')\"" action.permission=* action.action=allow action.pattern=*
