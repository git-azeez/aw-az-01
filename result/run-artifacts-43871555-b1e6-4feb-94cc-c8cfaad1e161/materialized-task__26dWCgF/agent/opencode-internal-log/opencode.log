timestamp=2026-10-10T05:51:48.473Z level=INFO run=dfcf5630 message=evaluated permission=bash pattern="cat > /tmp/work/lib.py <<'EOF'\nimport json, uuid, time, datetime as dt, hashlib, re, sys, urllib.request, urllib.parse, base64\nimport boto3, psycopg2, redis\ncfg = json.load(open('/workspace/config/config.json'))\nEP = cfg['aws_endpoint_url']; REGION = cfg['region']; PREFIX = cfg['resource_prefix']\ndef man(): return json.load(open('/workspace/submission/manifest.json'))\ndef cl(n): return boto3.client(n, endpoint_url=EP, region_name=REGION, aws_access_key_id='test', aws_secret_access_key='test')\ndef pg():\n    m = man()\n    c = psycopg2.connect(host=m['database']['endpoint'], port=m['database']['port'], user=cfg['db_username'], password=cfg['db_password'], dbname=cfg['db_name'], options='-c timezone=UTC')\n    c.autocommit = True; return c\ndef http(method, url, headers=None, body=None):\n    req = urllib.request.Request(url, data=body, method=method, headers=headers or {})\n    try:\n        with urllib.request.urlopen(req, timeout=20) as r: return r.status, dict((k.lower(), v) for k, v in r.headers.items()), r.read()\n    except urllib.error.HTTPError as e: return e.code, dict((k.lower(), v) for k, v in e.headers.items()), e.read()\n_tok = {}\ndef token(scope):\n    m = man(); c = m['auth']['clients'][scope]\n    auth = base64.b64encode(f\"{c['client_id']}:{c['client_secret']}\".encode()).decode()\n    s, h, b = http('POST', m['auth']['token_endpoint'], {'Authorization': 'Basic ' + auth, 'Content-Type': 'application/x-www-form-urlencoded'}, urllib.parse.urlencode({'grant_type': 'client_credentials', 'scope': 'clearledger/' + scope}).encode())\n    return json.loads(b)['access_token']\ndef api(method, path, scope, body=None, headers=None):\n    m = man(); h = {'Authorization': 'Bearer ' + token(scope), 'Content-Type': 'application/json'}; h.update(headers or {})\n    return http(method, m['service_url'] + path, h, json.dumps(body).encode() if body is not None else None)\ndef create(acct='ACC-2000'):\n    sid = str(uuid.uuid4())\n    s, h, b = api('POST', '/v1/settlements', 'write', {'settlementId': sid, 'accountId': acct, 'reference': 'REF-' + sid[:6], 'debitParty': 'BANK-A', 'creditParty': 'BANK-B', 'expectedVersion': 0}, {'Idempotency-Key': 'idem-' + sid, 'X-Correlation-Id': 'corr-' + sid})\n    assert s == 201, (s, b); return sid\ndef entry(sid, status, stage, v, memo=None, when=None):\n    e = str(uuid.uuid4()); when = when or (dt.datetime.utcnow() + dt.timedelta(seconds=v)).strftime('%Y-%m-%dT%H:%M:%S.%fZ')\n    s, h, b = api('POST', f'/v1/settlements/{sid}/entries', 'write', {'entryId': e, 'status': status, 'clearingStage': stage, 'memo': memo, 'occurredAt': when, 'expectedVersion': v}, {'Idempotency-Key': 'idem-' + e, 'X-Correlation-Id': 'corr-' + e})\n    assert s == 202, (s, b); return e\ndef traffic(n=4):\n    sids = []\n    for i in range(n):\n        sid = create('ACC-%d' % (3000 + i % 2)); sids.append(sid)\n        entry(sid, 'VALIDATED', 'VALIDATION', 1, 'ok ünï')\n        if i % 2: entry(sid, 'CLEARED', 'CLEARING', 2)\n        if i % 3 == 0: entry(sid, 'DISPUTED', 'DISPUTE', 3 if i % 2 else 2, 'dispute memo')\n    return sids\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-10-10T05:51:48.473Z level=INFO run=dfcf5630 message=evaluated permission=bash pattern="cat > /tmp/work/verify.py <<'EOF'\nimport sys; sys.path.insert(0, '/tmp/work')\nfrom lib import *\nm = man(); fails = []\ndef check(name, ok, detail=''):\n    print(('PASS ' if ok else 'FAIL ') + name + ((' :: ' + str(detail)) if (detail and not ok) else '')); \n    if not ok: fails.append(name)\nc = pg(); cur = c.cursor()\ncur.execute('select settlement_id::text, account_id, reference, debit_party, credit_party, current_status, current_stage, last_entry_id::text, last_memo, version, entry_count, updated_at from clearledger.settlements')\nS = {r[0]: r for r in cur.fetchall()}\ncur.execute('select settlement_id::text, aggregate_version, event_id::text, event_type, correlation_id, occurred_at, payload from clearledger.events')\nE = {}\nfor r in cur.fetchall(): E.setdefault(r[0], {})[r[1]] = r\ncur.execute('select count(*) from clearledger.outbox where published_at is null'); check('pg: no unpublished outbox', cur.fetchone()[0] == 0)\ncur.execute('select count(*) from clearledger.outbox where archived_at is null'); check('pg: all archived', cur.fetchone()[0] == 0)\nprint('settlements:', len(S), 'events:', sum(len(v) for v in E.values()))\n# DynamoDB\nd = cl('dynamodb'); items = []; kw = {'TableName': m['projections']['table_name'], 'ConsistentRead': True}\nwhile True:\n    r = d.scan(**kw); items += r['Items']\n    if 'LastEvaluatedKey' not in r: break\n    kw['ExclusiveStartKey'] = r['LastEvaluatedKey']\nkeys = {(i['PK']['S'], i['SK']['S']): i for i in items}\nexp_keys = set()\nfor sid, s in S.items():\n    exp_keys.add(('SETTLEMENT#' + sid, 'STATE'))\n    for v in range(1, s[9] + 1): exp_keys.add(('SETTLEMENT#' + sid, 'EVENT#%08d' % v))\ncheck('ddb: exact key set', set(keys) == exp_keys, (sorted(set(keys) - exp_keys)[:3], sorted(exp_keys - set(keys))[:3]))\ndef ts(x): return dt.datetime.fromisoformat(x.replace('Z', '+00:00'))\nbad = []\nfor sid, s in S.items():\n    st = keys.get(('SETTLEMENT#' + sid, 'STATE'))\n    if not st: continue\n    a = {k: list(v.values())[0] for k, v in st.items()}\n    ok = (a['GSI1PK'] == 'ACCOUNT#' + s[1] and a['GSI1SK'] == 'SETTLEMENT#' + sid and a['account_id'] == s[1] and a['reference'] == s[2] and a['debit_party'] == s[3] and a['credit_party'] == s[4] and a['status'] == s[5] and a['clearing_stage'] == s[6] and int(a['version']) == s[9] and int(a['entry_count']) == s[10] and ts(a['updated_at']) == s[11] and a.get('last_entry_id') == s[7] and a.get('last_memo') == s[8])\n    if not ok: bad.append(('STATE', sid))\n    for v, e in E.get(sid, {}).items():\n        it = keys.get(('SETTLEMENT#' + sid, 'EVENT#%08d' % v))\n        if not it: continue\n        a = {k: list(x.values())[0] for k, x in it.items()}\n        p = e[6]; dd = p['data']\n        ok = (a['event_id'] == e[2] and int(a['version']) == v and a['event_type'] == e[3] and a['correlation_id'] == e[4] and ts(a['occurred_at']) == e[5] and json.loads(a['envelope']) == p and a['status'] == dd['status'] and a['clearing_stage'] == dd['clearingStage'] and a.get('entry_id') == dd.get('entryId') and a.get('memo') == dd.get('memo') and set(a) <= {'PK','SK','settlement_id','event_id','version','event_type','status','clearing_stage','occurred_at','correlation_id','envelope','entry_id','memo'})\n        if not ok: bad.append(('EVENT', sid, v))\ncheck('ddb: attributes match PG', not bad, bad[:3])\n# GSI\ngi = d.query(TableName=m['projections']['table_name'], IndexName='AccountIndex', KeyConditionExpression='GSI1PK = :p', ExpressionAttributeValues={':p': {'S': 'ACCOUNT#ACC-3000'}})\ncheck('ddb: GSI query works', len(gi['Items']) == len([1 for s in S.values() if s[1] == 'ACC-3000']))\n# Valkey\nr = redis.Redis(host=m['cache']['endpoint'], port=m['cache']['port'], decode_responses=True)\nks = set(r.scan_iter('*')); want = {'clearledger:settlement:' + s for s in S}\ncheck('valkey: exact key set', ks == want, (sorted(ks - want)[:3], sorted(want - ks)[:3]))\ncheck('valkey: ttl in (0,90]', all(0 < r.ttl(k) <= 90 for k in ks))\nbad = []\nfor sid, s in S.items():\n    v = r.get('clearledger:settlement:' + sid)\n    if not v: continue\n    j = json.loads(v)\n    exp = {'settlementId': sid, 'accountId': s[1], 'reference': s[2], 'debitParty': s[3], 'creditParty': s[4], 'status': s[5], 'clearingStage': s[6], 'version': s[9], 'entryCount': s[10]}\n    if s[7]: exp['lastEntryId'] = s[7]\n    if s[8]: exp['lastMemo'] = s[8]\n    ju = ts(j.pop('updatedAt'))\n    if j != exp or ju != s[11]: bad.append(sid)\ncheck('valkey: payload matches PG', not bad, bad[:2])\n# API cache hit immediately\nsrcs = set()\nfor sid in list(S)[:5]:\n    st, h, b = api('GET', '/v1/settlements/' + sid, 'read'); srcs.add((st, h.get('x-clearledger-source')))\ncheck('api: GET served from cache', srcs <= {(200, 'cache')}, srcs)\n# S3\ns3 = cl('s3'); b = m['audit']['bucket_name']; vs, ms = [], []\nkw = {'Bucket': b}\nwhile True:\n    r_ = s3.list_object_versions(**kw); vs += r_.get('Versions', []); ms += r_.get('DeleteMarkers', [])\n    if not r_.get('IsTruncated'): break\n    kw['KeyMarker'] = r_['NextKeyMarker']; kw['VersionIdMarker'] = r_['NextVersionIdMarker']\ncheck('s3: no noncurrent versions / markers', all(v['IsLatest'] for v in vs) and not ms, (len(vs), len(ms)))\ncheck('s3: only ledger-audit/ objects', all(v['Key'].startswith('ledger-audit/') for v in vs))\ncur.execute('select seq, payload from clearledger.outbox order by seq'); O = cur.fetchall(); seen = []; rng = []\nrx = re.compile(r'^ledger-audit/batch-(\\d{8})-(\\d{8})-([0-9a-f]{16})\\.ndjson$'); okb = True\nfor v in vs:\n    mm = rx.match(v['Key'])\n    if not mm: okb = False; continue\n    body = s3.get_object(Bucket=b, Key=v['Key'])['Body'].read()\n    if hashlib.sha256(body).hexdigest()[:16] != mm.group(3): okb = False\n    lines = [json.loads(l) for l in body.decode().split('\\n') if l]\n    f, l = int(mm.group(1)), int(mm.group(2)); rng.append((f, l))\n    exp = [(sq, p) for sq, p in O if f <= sq <= l]\n    if [p for _, p in exp] != lines or [sq for sq, _ in exp] != list(range(f, l + 1)): okb = False\n    seen += [sq for sq, _ in exp]\ncheck('s3: batches canonical/contiguous', okb)\ncheck('s3: union == outbox exactly once', sorted(seen) == [sq for sq, _ in O], (len(seen), len(O)))\nrng.sort(); check('s3: disjoint ranges', all(rng[i][1] < rng[i + 1][0] for i in range(len(rng) - 1)))\n# control plane\nq = cl('sqs'); qa = q.get_queue_attributes(QueueUrl=m['messaging']['queue_url'], AttributeNames=['All'])['Attributes']\ncheck('sqs: main attrs', qa['VisibilityTimeout'] == '3' and qa['ReceiveMessageWaitTimeSeconds'] == '2' and qa['MessageRetentionPeriod'] == '172800' and json.loads(qa['RedrivePolicy'])['maxReceiveCount'] == 4 and json.loads(qa['RedrivePolicy'])['deadLetterTargetArn'] == m['messaging']['dlq_arn'], qa)\nda = q.get_queue_attributes(QueueUrl=m['messaging']['dlq_url'], AttributeNames=['All'])['Attributes']\ncheck('sqs: dlq attrs', da['MessageRetentionPeriod'] == '1209600', da)\ncheck('sqs: kms', qa.get('KmsMasterKeyId') and da.get('KmsMasterKeyId'))\nl = cl('lambda'); esms = l.list_event_source_mappings(FunctionName=m['workers']['projector']['function_name'])['EventSourceMappings']\ncheck('esm: one enabled mapping matching manifest', len(esms) == 1 and esms[0]['UUID'] == m['messaging']['event_source_mapping_uuid'] and esms[0]['State'] in ('Enabled', 'Enabling') and esms[0]['BatchSize'] == 5 and esms[0].get('FunctionResponseTypes') == ['ReportBatchItemFailures'] and esms[0]['EventSourceArn'] == m['messaging']['queue_arn'], esms)\nsch = cl('scheduler')\nfor nm, rate in [(m['schedules']['outbox_schedule_name'], 'rate(1 minute)'), (m['schedules']['archive_schedule_name'], 'rate(5 minutes)')]:\n    x = sch.get_schedule(Name=nm); check('schedule ' + nm, x['ScheduleExpression'] == rate and x['State'] == 'ENABLED' and x['FlexibleTimeWindow']['Mode'] == 'OFF', x['ScheduleExpression'])\nlg = cl('logs')\nfor g in m['logs'].values():\n    x = lg.describe_log_groups(logGroupNamePrefix=g)['logGroups']; x = [y for y in x if y['logGroupName'] == g]\n    check('logs ' + g, x and x[0].get('retentionInDays', 0) >= 14, x)\nenvs = {'projector': {'PROJECTION_TABLE': m['projections']['table_name'], 'CLOUDWATCH_LOG_GROUP': m['logs']['projector_log_group']},\n        'outbox_relay': {'SQS_QUEUE_URL': m['messaging']['queue_url'], 'OUTBOX_BATCH_SIZE': '50', 'CLOUDWATCH_LOG_GROUP': m['logs']['relay_log_group']},\n        'audit_archiver': {'AUDIT_BUCKET': m['audit']['bucket_name'], 'AUDIT_PREFIX': 'ledger-audit/', 'CLOUDWATCH_LOG_GROUP': m['logs']['archiver_log_group']}}\nfor w, e in envs.items():\n    v = l.get_function_configuration(FunctionName=m['workers'][w]['function_name'])['Environment']['Variables']\n    check('lambda env ' + w, all(v.get(k) == x for k, x in e.items()) and v['AWS_ENDPOINT_URL'] == EP, v)\niam = cl('iam')\nfor k, arn in m['iam'].items():\n    rn = arn.split('/')[-1]\n    inl = iam.list_role_policies(RoleName=rn)['PolicyNames']; att = iam.list_attached_role_policies(RoleName=rn)['AttachedPolicies']\n    check('iam ' + rn, inl == [rn] and not att, (inl, att))\npols = [p['PolicyName'] for p in iam.list_policies(Scope='Local')['Policies'] if p['PolicyName'].startswith(PREFIX)]\ncheck('iam: no prefixed managed policies', not pols, pols)\nec2 = cl('ec2'); sg = {g['GroupId']: g for g in ec2.describe_security_groups(GroupIds=list(m['network']['security_group_ids'].values()))['SecurityGroups']}\nids = m['network']['security_group_ids']\ncheck('sg: rds/valkey no egress', not sg[ids['rds']]['IpPermissionsEgress'] and not sg[ids['valkey']]['IpPermissionsEgress'])\ncheck('sg: alb egress restricted', all(p['IpProtocol'] == 'tcp' and p['FromPort'] == 8080 and p['ToPort'] == 8080 and not any(x['CidrIp'] == '0.0.0.0/0' for x in p['IpRanges']) for p in sg[ids['alb']]['IpPermissionsEgress']) and sg[ids['alb']]['IpPermissionsEgress'])\nst, h, b = http('GET', m['service_url'] + '/health/ready'); check('api ready', st == 200, b)\nprint('\\nFAILED: %s' % fails if fails else '\\nALL CHECKS PASSED'); sys.exit(1 if fails else 0)\nEOF" action.permission=* action.action=allow action.pattern=*
