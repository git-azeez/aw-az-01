timestamp=2026-10-10T05:52:12.714Z level=INFO run=dfcf5630 message=evaluated permission=bash pattern="cat > /tmp/work/chaos.py <<'EOF'\nimport sys; sys.path.insert(0, '/tmp/work')\nfrom lib import *\nm = man(); c = pg(); cur = c.cursor()\nsids = traffic(6); print('traffic done', len(sids)); time.sleep(4)\n# archive some so there are archived + unarchived rows, then un-publish a tail\nl = cl('lambda'); l.invoke(FunctionName=m['workers']['audit_archiver']['function_name'], Payload=b'{}'); time.sleep(1)\ncur.execute(\"update clearledger.outbox set published_at=NULL, archived_at=NULL where seq > (select max(seq)-5 from clearledger.outbox)\"); print('unpublished rows', cur.rowcount)\n# SQS\nq = cl('sqs'); q.set_queue_attributes(QueueUrl=m['messaging']['dlq_url'], Attributes={'MessageRetentionPeriod': '3600'})\nq.delete_queue(QueueUrl=m['messaging']['queue_url']); print('main queue deleted')\n# ESM\nfor e in l.list_event_source_mappings()['EventSourceMappings']:\n    if m['workers']['projector']['function_name'] in e['FunctionArn']:\n        try: l.delete_event_source_mapping(UUID=e['UUID']); print('esm deleted')\n        except Exception as ex: print('esm delete', ex)\n# schedules\nsch = cl('scheduler'); sch.delete_schedule(Name=m['schedules']['archive_schedule_name'])\nx = sch.get_schedule(Name=m['schedules']['outbox_schedule_name'])\nsch.update_schedule(Name=x['Name'], ScheduleExpression='rate(10 minutes)', State='DISABLED', FlexibleTimeWindow=x['FlexibleTimeWindow'], Target=x['Target']); print('schedules tampered')\n# logs\nlg = cl('logs'); lg.put_retention_policy(logGroupName=m['logs']['api_log_group'], retentionInDays=1)\n# lambda env\nfor w in ['outbox_relay', 'projector']:\n    fn = m['workers'][w]['function_name']; v = l.get_function_configuration(FunctionName=fn)['Environment']['Variables']\n    v['OUTBOX_BATCH_SIZE'] = '1'; v['AWS_ENDPOINT_URL'] = 'http://evil:1'; v.pop('CLOUDWATCH_LOG_GROUP', None)\n    l.update_function_configuration(FunctionName=fn, Environment={'Variables': v})\nprint('lambda env tampered')\n# IAM\niam = cl('iam'); pdoc = json.dumps({'Version': '2012-10-17', 'Statement': [{'Effect': 'Allow', 'Action': 's3:*', 'Resource': '*'}]})\npol = iam.create_policy(PolicyName=PREFIX + '-breakglass', PolicyDocument=pdoc)['Policy']['Arn']\niam.create_policy_version(PolicyArn=pol, PolicyDocument=pdoc.replace('s3', 'sqs'), SetAsDefault=False)\ndet = iam.create_policy(PolicyName=PREFIX + '-detached-multi', PolicyDocument=pdoc)['Policy']['Arn']\niam.create_policy_version(PolicyArn=det, PolicyDocument=pdoc.replace('s3', 'kms'), SetAsDefault=True)\nfor k, arn in m['iam'].items():\n    rn = arn.split('/')[-1]; iam.put_role_policy(RoleName=rn, PolicyName='oob-inline', PolicyDocument=pdoc)\n    iam.attach_role_policy(RoleName=rn, PolicyArn=pol)\ntry: iam.attach_role_policy(RoleName=m['iam']['archiver_role_arn'].split('/')[-1], PolicyArn='arn:aws:iam::aws:policy/AdministratorAccess')\nexcept Exception as ex: print('aws managed attach', ex)\nprint('iam tampered')\n# SG\nec2 = cl('ec2'); ids = m['network']['security_group_ids']\nfor n in ['rds', 'valkey']: ec2.authorize_security_group_egress(GroupId=ids[n], IpPermissions=[{'IpProtocol': '-1', 'IpRanges': [{'CidrIp': '0.0.0.0/0'}]}])\nec2.authorize_security_group_egress(GroupId=ids['alb'], IpPermissions=[{'IpProtocol': '-1', 'IpRanges': [{'CidrIp': '0.0.0.0/0'}]}])\nprint('sg tampered')\n# DDB\nd = cl('dynamodb'); T = m['projections']['table_name']; cur.execute('select settlement_id::text, version from clearledger.settlements order by created_at'); S = cur.fetchall()\ns0, s1, s2, s3_ = S[-1][0], S[-2][0], S[-3][0], S[-4][0]\nd.delete_item(TableName=T, Key={'PK': {'S': 'SETTLEMENT#' + s0}, 'SK': {'S': 'EVENT#00000001'}})\nd.delete_item(TableName=T, Key={'PK': {'S': 'SETTLEMENT#' + s1}, 'SK': {'S': 'STATE'}})\norph = str(uuid.uuid4())\nfor sk in ['STATE', 'EVENT#00000001']: d.put_item(TableName=T, Item={'PK': {'S': 'SETTLEMENT#' + orph}, 'SK': {'S': sk}, 'GSI1PK': {'S': 'ACCOUNT#X'}, 'GSI1SK': {'S': 'S'}})\nd.put_item(TableName=T, Item={'PK': {'S': 'SETTLEMENT#' + s2}, 'SK': {'S': 'EVENT#00000099'}})\nd.put_item(TableName=T, Item={'PK': {'S': 'SETTLEMENT#' + s2}, 'SK': {'S': 'FOO'}})\nd.update_item(TableName=T, Key={'PK': {'S': 'SETTLEMENT#' + s3_}, 'SK': {'S': 'STATE'}}, UpdateExpression='SET #s=:s, version=:v, GSI1PK=:g, extra=:x REMOVE last_memo', ExpressionAttributeNames={'#s': 'status'}, ExpressionAttributeValues={':s': {'S': 'BOGUS'}, ':v': {'N': '99'}, ':g': {'S': 'ACCOUNT#WRONG'}, ':x': {'S': 'y'}})\nd.update_item(TableName=T, Key={'PK': {'S': 'SETTLEMENT#' + s3_}, 'SK': {'S': 'EVENT#00000002'}}, UpdateExpression='SET envelope=:e, memo=:m', ExpressionAttributeValues={':e': {'S': '{\"bad\":1}'}, ':m': {'S': 'tampered'}})\nprint('ddb tampered')\n# Valkey\nr = redis.Redis(host=m['cache']['endpoint'], port=m['cache']['port'], decode_responses=True)\nr.set('foo', 'bar'); r.set('clearledger:settlement:' + orph, '{}', ex=50); r.set('clearledger:settlement:' + s0, '{\"stale\":true}'); r.set('clearledger:other:' + s0, '1')\nr.select if False else None\nrdb1 = redis.Redis(host=m['cache']['endpoint'], port=m['cache']['port'], db=1); rdb1.set('x', 'y')\nprint('valkey tampered')\n# S3\ns3 = cl('s3'); B = m['audit']['bucket_name']\ns3.put_object(Bucket=B, Key='other/x.txt', Body=b'x'); s3.put_object(Bucket=B, Key='ledger-audit/junk.txt', Body=b'junk')\ns3.put_object(Bucket=B, Key='ledger-audit/batch-00000002-00000003-0000000000000000.ndjson', Body=b'{}\\n')\nvs = [v for v in s3.list_object_versions(Bucket=B).get('Versions', []) if v['Key'].startswith('ledger-audit/batch-0')]\nprint('batches', [v['Key'] for v in vs])\nif vs:\n    k = vs[0]['Key']; s3.delete_object(Bucket=B, Key=k)  # delete marker\n    if len(vs) > 1: s3.put_object(Bucket=B, Key=vs[1]['Key'], Body=b'tampered\\n')\nprint('s3 tampered')\nEOF" action.permission=* action.action=allow action.pattern=*
