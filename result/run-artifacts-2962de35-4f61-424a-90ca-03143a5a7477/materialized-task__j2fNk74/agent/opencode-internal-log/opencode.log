timestamp=2026-10-10T09:03:33.624Z level=INFO run=95d1806c message=evaluated permission=bash pattern="cat > /tmp/cl/client.py <<'EOF'\nimport json, sys, uuid, requests, datetime, time\nM=json.load(open('/workspace/submission/manifest.json' if len(sys.argv)<99 else ''))if False else json.load(open('/tmp/cl/m.json'))\nBASE=\"http://aws:80\"\n_tok={}\ndef tok(kind):\n    if kind in _tok: return _tok[kind]\n    c=M['auth']['clients'][kind]\n    r=requests.post(M['auth']['token_endpoint'],auth=(c['client_id'],c['client_secret']),data={'grant_type':'client_credentials','scope':c['scope']})\n    _tok[kind]=r.json()['access_token']; return _tok[kind]\ndef H(kind,**kw):\n    h={'Authorization':'Bearer '+tok(kind)}; h.update(kw); return h\ndef create(sid=None, **over):\n    sid=sid or str(uuid.uuid4())\n    body={'settlementId':sid,'accountId':'ACC-001','reference':'REF-123','debitParty':'BANKA','creditParty':'BANKB','expectedVersion':0}\n    body.update(over)\n    r=requests.post(BASE+'/v1/settlements',json=body,headers=H('write',**{'Idempotency-Key':'idem-'+uuid.uuid4().hex[:12],'X-Correlation-Id':'corr-'+uuid.uuid4().hex[:8]}))\n    return sid,r\ndef append(sid,ver,status,stage='STAGE-X',memo='m',occ=None,key=None,entry=None):\n    occ=occ or (datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=ver)).isoformat().replace('+00:00','Z')\n    body={'entryId':entry or str(uuid.uuid4()),'status':status,'clearingStage':stage,'memo':memo,'occurredAt':occ,'expectedVersion':ver}\n    r=requests.post(f'{BASE}/v1/settlements/{sid}/entries',json=body,headers=H('write',**{'Idempotency-Key':key or 'idem-'+uuid.uuid4().hex[:12],'X-Correlation-Id':'corr-'+uuid.uuid4().hex[:8]}))\n    return r\ndef get(sid,suffix=''):\n    return requests.get(f'{BASE}/v1/settlements/{sid}{suffix}',headers=H('read'))\nEOF" action.permission=* action.action=allow action.pattern=*
