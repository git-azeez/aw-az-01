    } catch {}
    procs.push({ pid, ppid, cmdline, cpu });
  }
  const agentPids = procs.filter((p) => isAgentCmdline(p.cmdline)).map((p) => p.pid);
  const agentSet = new Set(agentPids);
  const byParent = new Map();
  for (const p of procs) {
    if (!byParent.has(p.ppid)) byParent.set(p.ppid, []);
    byParent.get(p.ppid).push(p.pid);
  }
  const treeSet = new Set(agentPids);
  const stack = [...agentPids];
  while (stack.length) {
    for (const c of byParent.get(stack.pop()) || []) {
      if (!treeSet.has(c)) { treeSet.add(c); stack.push(c); }
    }
  }
  const childPids = [...treeSet].filter((p) => !agentSet.has(p));
  let treeCpu = 0;
  for (const p of procs) if (treeSet.has(p.pid)) treeCpu += p.cpu;
  return { agentPids, childPids, treeCpu };
}

function stall(kind, snapshot) {
