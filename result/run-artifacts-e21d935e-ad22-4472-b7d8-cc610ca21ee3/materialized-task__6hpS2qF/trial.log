  const actualOrder = Object.prototype.hasOwnProperty.call(actual, "order");
  if (expectedOrder !== actualOrder) return false;
  if (expectedOrder && actual.order[0] !== FROZEN_PROVIDER_POLICY.order[0]) return false;
