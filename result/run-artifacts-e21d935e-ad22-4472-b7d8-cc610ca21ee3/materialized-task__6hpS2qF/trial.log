  const path = (req.url || "").split("?")[0];
  if (req.method !== "POST" || !path.endsWith("/chat/completions")) return body;
  if (FROZEN_PROVIDER_POLICY_ERROR || !FROZEN_PROVIDER_POLICY || !FROZEN_PROVIDER_MODEL) {
    rejectFrozen(FROZEN_PROVIDER_POLICY_ERROR || "missing");
  }
  const encoding = String(req.headers["content-encoding"] || "").toLowerCase();
  if (encoding && encoding !== "identity") rejectFrozen("opaque_body");
  if (!body.length) rejectFrozen("missing");
  const text = body.toString("utf8");
  const brace = text.indexOf("{");
  if (brace === -1 || text.slice(0, brace).trim() !== "") rejectFrozen("unreadable_body");
  if (!/^\s*"/.test(text.slice(brace + 1))) rejectFrozen("unreadable_body");
  let payload;
  try { payload = JSON.parse(text); } catch { rejectFrozen("unreadable_body"); }
  if (!payload || typeof payload !== "object" || Array.isArray(payload)) rejectFrozen("unreadable_body");
  // Match the same Moonshot spellings accepted by openrouter_provider_pin.
  // Other model changes still refuse: they have no accepted price or route.
  function frozenModelIdentity(model) {
    if (typeof model !== "string") return null;
    return model.replace(/^openrouter\//, "").replace(/^moonshotai\//, "");
  }
  if (frozenModelIdentity(payload.model) !== frozenModelIdentity(FROZEN_PROVIDER_MODEL)) {
    rejectFrozen("model");
  }
  if (Object.prototype.hasOwnProperty.call(payload, "provider")) {
    if (!frozenPoliciesMatch(payload.provider)) rejectFrozen("conflict");
    if (!cacheProviderInjectLogged) {
      cacheProviderInjectLogged = true;
      emit({ event: "llm_idle_proxy.frozen_provider_verified", model: FROZEN_PROVIDER_MODEL });
    }
    return body;
  }
  if (!cacheProviderInjectLogged) {
    cacheProviderInjectLogged = true;
    const injected = {
      event: "llm_idle_proxy.frozen_provider_injected",
      model: FROZEN_PROVIDER_MODEL,
      allow_fallbacks: FROZEN_PROVIDER_POLICY.allow_fallbacks,
      max_price: FROZEN_PROVIDER_POLICY.max_price,
    };
    if (Object.prototype.hasOwnProperty.call(FROZEN_PROVIDER_POLICY, "order")) {
      injected.order = FROZEN_PROVIDER_POLICY.order;
    }
    emit(injected);
  }
  const provider = {
    allow_fallbacks: FROZEN_PROVIDER_POLICY.allow_fallbacks,
    max_price: {
      completion: FROZEN_PROVIDER_POLICY.max_price.completion,
      prompt: FROZEN_PROVIDER_POLICY.max_price.prompt,
    },
  };
  if (Object.prototype.hasOwnProperty.call(FROZEN_PROVIDER_POLICY, "order")) {
    provider.order = FROZEN_PROVIDER_POLICY.order;
  }
  const providerJson = JSON.stringify(provider);
  return Buffer.from(
    text.slice(0, brace + 1) + '"provider":' + providerJson + "," + text.slice(brace + 1),
    "utf8",
  );
}

function withCacheProvider(req, body) {
  if (FROZEN_PROVIDER_POLICY || FROZEN_PROVIDER_POLICY_ERROR) {
    return withFrozenProviderPolicy(req, body);
  }
  if (!CACHE_PROVIDER_MODELS.size || !CACHE_PROVIDER_ORDER.length ||
      req.method !== "POST" || !body.length) return body;
  const path = (req.url || "").split("?")[0];
  if (!path.endsWith("/chat/completions")) return body;
  const encoding = String(req.headers["content-encoding"] || "").toLowerCase();
  if (encoding && encoding !== "identity") return body;
  const text = body.toString("utf8");
  const brace = text.indexOf("{");
  if (brace === -1 || text.slice(0, brace).trim() !== "") return body;
  if (!/^\s*"/.test(text.slice(brace + 1))) return body;
  // Parse only to inspect top-level keys, then splice the original bytes.
  // This avoids re-serializing multi-MB image bodies while reliably
  // distinguishing a real provider policy from prompt text that happens
  // to contain the word "provider".
  let payload;
  try { payload = JSON.parse(text); } catch { return body; }
  if (!payload || typeof payload !== "object" || !CACHE_PROVIDER_MODELS.has(payload.model)) {
    return body;
  }
  if (Object.prototype.hasOwnProperty.call(payload, "provider")) {
    if (!cacheProviderPresentLogged) {
      cacheProviderPresentLogged = true;
      emit({ event: "llm_idle_proxy.cache_provider_present", path, model: payload.model });
    }
    return body;
  }
  if (!cacheProviderInjectLogged) {
    cacheProviderInjectLogged = true;
    emit({
      event: "llm_idle_proxy.cache_provider_injected",
      path,
      model: payload.model,
      order: CACHE_PROVIDER_ORDER,
      allow_fallbacks: CACHE_PROVIDER_ALLOW_FALLBACKS,
      zdr: CACHE_PROVIDER_ZDR,
    });
  }
  return Buffer.from(
    text.slice(0, brace + 1) +
      '"provider":{"order":' + JSON.stringify(CACHE_PROVIDER_ORDER) +
        ',"allow_fallbacks":' + JSON.stringify(CACHE_PROVIDER_ALLOW_FALLBACKS) +
        (CACHE_PROVIDER_ZDR ? ',"zdr":true' : '') + '},' +
      text.slice(brace + 1),
    "utf8",
  );
}

function withMaxTokensRewrite(req, body) {
  if (!MAX_TOKENS_REWRITE_MODELS.size || req.method !== "POST" || !body.length) return body;
  const path = (req.url || "").split("?")[0];
  if (!MAX_TOKENS_REWRITE_PATHS.has(path)) return body;
  const encoding = String(req.headers["content-encoding"] || "").toLowerCase();
  if (encoding && encoding !== "identity") return body;
  let payload;
  try {
    payload = JSON.parse(body.toString("utf8"));
  } catch {
    return body;
  }
  if (!payload || typeof payload !== "object" || !MAX_TOKENS_REWRITE_MODELS.has(payload.model)) {
    return body;
  }
  if (payload.max_tokens !== TARGET_MAX_TOKENS) {
    // Not the clamped shape. Record what actually went upstream so the
    // post-run assertion can tell "already had full budget" (the healthy
    // case once OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX lands) apart from
    // "shipped capped and nobody fixed it". Without this the assertion is
    // inverted: it demands a rewrite that a correctly-configured run never
    // needs, and would fail every such trial.
    // An ABSENT max_tokens means "use the provider's default budget", not
    // "shipped under-budget" · a plausible future opencode shape (drop the
    // key rather than raise it). `undefined >= N` is false, so without the
    // null check that healthy body would emit max_tokens_capped and exit 86
    // a completed benchmark result.
    emit({
      event: payload.max_tokens == null || payload.max_tokens >= REWRITE_MAX_TOKENS
        ? "llm_idle_proxy.max_tokens_ok"
        : "llm_idle_proxy.max_tokens_capped",
      path,
      model: payload.model,
      max_tokens: payload.max_tokens === undefined ? null : payload.max_tokens,
      required_max_tokens: REWRITE_MAX_TOKENS,
    });
    return body;
  }
  payload.max_tokens = REWRITE_MAX_TOKENS;
  emit({
    event: "llm_idle_proxy.max_tokens_rewrite",
    path,
    model: payload.model,
    old_max_tokens: TARGET_MAX_TOKENS,
    new_max_tokens: REWRITE_MAX_TOKENS,
  });
  return Buffer.from(JSON.stringify(payload), "utf8");
}

function budgetPinError(pin) {
  if (!pin || typeof pin !== "object" || Array.isArray(pin)) return "malformed";
  if (pin.provider !== "openrouter" && pin.provider !== "openai") return "provider";
  if (typeof pin.model !== "string" || !pin.model) return "model";
  if (!Array.isArray(pin.aliases) || !pin.aliases.length) return "aliases";
  if (pin.aliases.some((item) => typeof item !== "string" || !item)) return "aliases";
  if (!pin.endpoints || typeof pin.endpoints !== "object" || Array.isArray(pin.endpoints)) return "endpoints";
  const paths = Object.keys(pin.endpoints);
  if (!paths.length) return "endpoints";
  for (const path of paths) {
    const field = pin.endpoints[path];
    if ((field !== "max_tokens" && field !== "max_output_tokens") || !path.startsWith("/")) return "endpoints";
  }
  if (!Number.isInteger(pin.output_token_cap) || pin.output_token_cap < 1) return "output_cap";
  if (!Number.isInteger(pin.input_token_cap) || pin.input_token_cap < 1) return "input_cap";
  if (typeof pin.maximum_charge_usd !== "string" || !/^\d+\.\d{6}$/.test(pin.maximum_charge_usd)) return "maximum";
  if (pin.maximum_charge_usd === "0.000000") return "maximum";
  if (!Number.isInteger(pin.input_microusd_per_mtok) || pin.input_microusd_per_mtok <= 0) return "rate";
  if (!Number.isInteger(pin.output_microusd_per_mtok) || pin.output_microusd_per_mtok <= 0) return "rate";
  if (pin.rate_tiers !== undefined) {
    // Ascending prompt-token ceilings. The last tier ends at the input cap
    // and no tier may price above the top-level rates that set the maximum.
    const tiers = pin.rate_tiers;
    if (!Array.isArray(tiers) || !tiers.length) return "tiers";
    let floor = 0;
    for (const tier of tiers) {
      if (!tier || typeof tier !== "object" || Array.isArray(tier)) return "tiers";
      if (!Number.isInteger(tier.max_input_tokens) || tier.max_input_tokens <= floor) return "tiers";
      if (!Number.isInteger(tier.input_microusd_per_mtok) || tier.input_microusd_per_mtok <= 0) return "tiers";
      if (!Number.isInteger(tier.output_microusd_per_mtok) || tier.output_microusd_per_mtok <= 0) return "tiers";
      if (tier.input_microusd_per_mtok > pin.input_microusd_per_mtok) return "tiers";
      if (tier.output_microusd_per_mtok > pin.output_microusd_per_mtok) return "tiers";
      floor = tier.max_input_tokens;
    }
    if (floor !== pin.input_token_cap) return "tiers";
  }
  return "";
}

function rejectBudget(reason) {
  const error = new Error(reason || "denied");
  error.code = "RUN_BUDGET";
  throw error;
}

function withBudgetOutputCap(req, body) {
  if (!BUDGET_REQUIRED) return body;
  if (BUDGET_PIN_ERROR || !BUDGET_PIN) rejectBudget(BUDGET_PIN_ERROR || "missing");
  if (req.method !== "POST") rejectBudget("method");
  const path = (req.url || "").split("?")[0];
  const field = BUDGET_PIN.endpoints[path];
  if (!field) rejectBudget("endpoint");
  let payload;
  try { payload = JSON.parse(body.toString("utf8")); } catch { rejectBudget("unreadable_body"); }
  if (!payload || typeof payload !== "object" || Array.isArray(payload)) rejectBudget("unreadable_body");
  if (!BUDGET_PIN.aliases.includes(payload.model)) rejectBudget("model");
  if (TRUSTED_FORWARDER && (
    Object.prototype.hasOwnProperty.call(payload, "api_key")
    || Object.prototype.hasOwnProperty.call(payload, "key_lane")
    || Object.prototype.hasOwnProperty.call(payload, "account")
  )) rejectBudget("account");
  const cap = BUDGET_PIN.output_token_cap;
  const current = payload[field];
  if (current !== undefined && (!Number.isInteger(current) || current < 1)) rejectBudget("output_limit");
  // The published window already bounds an omitted limit. Write the cap
  // only when the caller asked for more than that window.
  if (Number.isInteger(current) && current > cap) payload[field] = cap;
  // Chat accepts max_completion_tokens as an alias of the pinned field.
  // Same rule as TrustedBudgetForwarder._prepare. A supplied alias must
  // be a positive integer. It is clamped to the lower of itself and the
  // pinned field, or to the window when that field is omitted. The pinned
  // field is then removed so the provider sees one limit. The MAI rewrite
  // moves max_tokens onto this alias before this function runs.
  if (path.endsWith("/chat/completions") && Object.prototype.hasOwnProperty.call(payload, "max_completion_tokens")) {
    const alias = payload.max_completion_tokens;
    if (!Number.isInteger(alias) || alias < 1) rejectBudget("output_limit");
    const pinned = Object.prototype.hasOwnProperty.call(payload, field) ? payload[field] : cap;
    payload.max_completion_tokens = Math.min(alias, pinned);
    if (field !== "max_completion_tokens") delete payload[field];
  }
  return Buffer.from(JSON.stringify(payload));
}

const budgetRetryOrdinal = new Map();

function budgetIncarnation() {
  // Attempt and dispatch generation are explicit. Cache affinity, session
  // id, and prompt_cache_key are not an incarnation and are not read here.
  const attempt = String(process.env.M1_RUN_ATTEMPT ?? "");
  const generation = String(process.env.M1_RUN_DISPATCH_GENERATION ?? "");
  if (!/^[1-9][0-9]*$/.test(attempt)) return null;
  if (!/^(0|[1-9][0-9]*)$/.test(generation)) return null;
  return { attempt, generation };
}

function budgetRetryKey(path, body) {
  const incarnation = budgetIncarnation();
  if (!incarnation) return null;
  return incarnation.attempt + "\n" + incarnation.generation + "\n" + String(path) + "\n"
    + createHash("sha256").update(body).digest("hex");
}

function requestUuid(path, body, retryOrdinal) {
  const incarnation = budgetIncarnation();
  if (!incarnation) return null;
  const hex = createHash("sha256")
    .update(String(process.env.M1_RUN_ID || ""))
    .update("\n")
    .update(incarnation.attempt)
    .update("\n")
    .update(incarnation.generation)
    .update("\n")
    .update(String(path))
    .update("\n")
    .update(body)
    .update("\n")
    .update(String(retryOrdinal))
    .digest("hex");
  return hex.slice(0, 8) + "-" + hex.slice(8, 12) + "-" + hex.slice(12, 16) + "-" + hex.slice(16, 20) + "-" + hex.slice(20, 32);
}

function rateLimitIsUnbilled(buf) {
  // Only a usage-free 429 is unbilled. A usage field we cannot price, or
  // any positive cost or token count, keeps the hold.
  const text = buf.toString("utf8").trim();
  if (!text) return true;
  let obj;
  try { obj = JSON.parse(text); } catch { return true; }
  if (!obj || typeof obj !== "object" || Array.isArray(obj)) return true;
  const usage = usageFromBody(buf, "application/json");
  if (!usage) return true;
  if (Object.prototype.hasOwnProperty.call(usage, "cost")) {
    const cost = moneyString(usage.cost);
    if (cost === null || moneyMicros(cost) > 0n) return false;
  }
  const input = usage.prompt_tokens !== undefined ? usage.prompt_tokens : usage.input_tokens;
  const output = usage.completion_tokens !== undefined ? usage.completion_tokens : usage.output_tokens;
  if (input !== undefined && (!Number.isInteger(input) || input > 0)) return false;
  if (output !== undefined && (!Number.isInteger(output) || output > 0)) return false;
  return true;
}

function budgetPost(urlPath, payload) {
  return new Promise((resolve) => {
    let settled = false;
    const finish = (value) => {
      if (settled) return;
      settled = true;
      resolve(value);
    };
    let target;
    try {
      target = new URL(String(process.env.M1_RUN_BUDGET_URL || "") + urlPath);
    } catch {
      finish(null);
      return;
    }
    if (target.protocol !== "http:" && target.protocol !== "https:") {
      finish(null);
      return;
    }
    const data = Buffer.from(JSON.stringify(payload));
    const lib = target.protocol === "https:" ? https : http;
    const request = lib.request({
      protocol: target.protocol,
      hostname: target.hostname,
      port: target.port,
      method: "POST",
      path: target.pathname + target.search,
      headers: {
        "content-type": "application/json",
        "content-length": String(data.length),
        authorization: "Bearer " + String(process.env.M1_RUN_BUDGET_TOKEN || ""),
      },
    }, (response) => {
      const chunks = [];
      response.on("data", (chunk) => chunks.push(chunk));
      response.on("end", () => {
        finish({
          status: response.statusCode || 0,
          fresh: String(response.headers["x-m1-budget-fresh"] || ""),
          body: Buffer.concat(chunks).toString("utf8"),
        });
      });
    });
    request.on("error", () => finish(null));
    request.setTimeout(10000, () => {
      request.destroy();
      finish(null);
    });
    request.end(data);
  });
}

async function reserveRunBudget(req, body) {
  if (BUDGET_PIN_ERROR || !BUDGET_PIN) return null;
  const runId = String(process.env.M1_RUN_ID || "");
  if (!runId) return null;
  const path = (req.url || "").split("?")[0];
  if (req.method !== "POST" || !BUDGET_PIN.endpoints[path]) return null;
  let payload;
  try { payload = JSON.parse(body.toString("utf8")); } catch { return null; }
  if (!payload || typeof payload !== "object" || !BUDGET_PIN.aliases.includes(payload.model)) return null;
  const retryKey = budgetRetryKey(path, body);
  if (!retryKey) return null;
  const ordinal = budgetRetryOrdinal.get(retryKey) || 0;
  const requestId = requestUuid(path, body, ordinal);
  if (!requestId) return null;
  const response = await budgetPost(
    "/internal/runs/" + runId + "/llm-budget/reservations",
    {
      request_id: requestId,
      provider: BUDGET_PIN.provider,
      model: BUDGET_PIN.model,
      endpoint: path,
      maximum_charge_usd: BUDGET_PIN.maximum_charge_usd,
    },
  );
  if (!response || response.status !== 200 || response.fresh !== "true") return null;
  let parsed;
  try { parsed = JSON.parse(response.body); } catch { return null; }
  const keys = parsed && typeof parsed === "object" && !Array.isArray(parsed) ? Object.keys(parsed).sort() : [];
  if (keys.length !== 2 || keys[0] !== "request_id" || keys[1] !== "status") return null;
  if (parsed.status !== "reserved" || parsed.request_id !== requestId) return null;
  return { requestId, model: BUDGET_PIN.model, retryKey, ordinal };
}

async function releaseUnbilledRateLimit(reservation) {
  const runId = String(process.env.M1_RUN_ID || "");
  const response = await budgetPost(
    "/internal/runs/" + runId + "/llm-budget/reservations/" + reservation.requestId + "/settle",
    {
      model: reservation.model,
      actual_charge_usd: "0.000000",
      cost_source: "upstream_429_unbilled",
      normalized_usage: { http_status: 429 },
    },
  );
  if (!response || response.status !== 200) return false;
  try {
    const parsed = JSON.parse(response.body);
    return Boolean(parsed && parsed.status === "settled" && parsed.request_id === reservation.requestId);
  } catch {
    return false;
  }
}

function moneyString(value) {
  if (typeof value !== "string" && typeof value !== "number") return null;
  if (typeof value === "number" && (!Number.isFinite(value) || value < 0)) return null;
  const text = String(value);
  if (text.length > 256) return null;
  const match = /^(\d+)(?:\.(\d+))?(?:[eE]([+-]?\d+))?$/.exec(text);
  if (!match) return null;
  const fraction = match[2] || "";
  const exponent = Number(match[3] || 0);
  if (!Number.isInteger(exponent) || Math.abs(exponent) > 100) return null;
  const digits = BigInt(match[1] + fraction);
  const scale = fraction.length - exponent - 6;
  const divisor = scale > 0 ? 10n ** BigInt(scale) : 1n;
  const micros = scale > 0 ? (digits + divisor - 1n) / divisor : digits * (10n ** BigInt(-scale));
  return (micros / 1000000n).toString() + "." + (micros % 1000000n).toString().padStart(6, "0");
}

function moneyMicros(text) {
  const parts = text.split(".");
  return BigInt(parts[0]) * 1000000n + BigInt(parts[1]);
}

function usageRecord(obj) {
  if (!obj || typeof obj !== "object" || Array.isArray(obj)) return null;
  if (
    ["response.completed", "response.incomplete", "response.failed"].includes(obj.type)
    && obj.response
    && typeof obj.response.usage === "object"
    && !Array.isArray(obj.response.usage)
  ) {
    return { usage: obj.response.usage, terminal: true };
  }
  if (!obj.usage || typeof obj.usage !== "object" || Array.isArray(obj.usage)) return null;
  const choiceDone = Array.isArray(obj.choices)
    && obj.choices.some((choice) => choice && choice.finish_reason);
  return {
    usage: obj.usage,
    terminal: ["response.completed", "response.incomplete", "response.failed"].includes(obj.type) || Boolean(obj.finish_reason) || choiceDone,
  };
}

function noteSseLine(line, state) {
  const trimmed = String(line).replace(/\r$/, "").trim();
  if (!trimmed.startsWith("data:")) return;
  const data = trimmed.slice(5).trim();
  if (data === "[DONE]") {
    if (state.usage) state.terminal = true;
    return;
  }
  try {
    const found = usageRecord(JSON.parse(data));
    if (!found) return;
    state.usage = found.usage;
    if (found.terminal) state.terminal = true;
  } catch {}
}

function unfinishedSseCanHoldUsage(carry) {
  const trimmed = carry.replace(/^\s+/, "");
  return "data:".startsWith(trimmed) || trimmed.startsWith("data:");
}

function absorbSse(text, state) {
  state.carry += text;
  const lines = state.carry.split("\n");
  state.carry = lines.pop() || "";
  // Responses API puts usage on one response.completed line that includes
  // the whole output. Keep an unfinished data line up to the 2 MiB body
  // cap. Drop any other unfinished line once it cannot be usage.
  const carryCap = 2 * 1024 * 1024;
  if (
    state.carry.length > carryCap
    || (state.carry.length > 65536 && !unfinishedSseCanHoldUsage(state.carry))
  ) {
    state.carry = "";
  }
  for (const line of lines) noteSseLine(line, state);
}

function usageFromBody(buf, contentType) {
  const text = buf.toString("utf8");
  if (String(contentType || "").includes("text/event-stream")) {
    // A stream without a completion marker can be a partial body. Leave
    // the reservation at its maximum instead of settling a short usage.
    const state = { carry: "", usage: null, terminal: false };
    absorbSse(text, state);
    if (state.carry) noteSseLine(state.carry, state);
    return state.terminal ? state.usage : null;
  }
  try {
    const obj = JSON.parse(text);
    if (!obj || typeof obj !== "object" || Array.isArray(obj)) return null;
    const nested = obj.response && typeof obj.response.usage === "object" && !Array.isArray(obj.response.usage)
      ? obj.response.usage
      : null;
    if (obj.usage && typeof obj.usage === "object" && !Array.isArray(obj.usage)) return obj.usage;
    return nested;
  } catch {
    return null;
  }
}

function chargeFromUsage(usage) {
  if (!usage || typeof usage !== "object" || !BUDGET_PIN) return null;
  // Only OpenRouter reports a billed cost. An OpenAI pin prices tokens.
  if (BUDGET_PIN.provider === "openrouter" && Object.prototype.hasOwnProperty.call(usage, "cost")) {
    const text = moneyString(usage.cost);
    if (!text) return null;
    return { usd: text, source: "openrouter_usage_cost", usage };
  }
  // Mirrors pinned_usage_charge in run_spend_guard.py. Usage that cannot
  // be priced returns null, so the full reservation stays held.
  const input = usageCount(usage, "prompt_tokens", "input_tokens");
  const output = usageCount(usage, "completion_tokens", "output_tokens");
  if (input === null || output === null) return null;
  if (input > BUDGET_PIN.input_token_cap || output > BUDGET_PIN.output_token_cap) return null;
  if (Object.prototype.hasOwnProperty.call(usage, "total_tokens")
      && (!Number.isInteger(usage.total_tokens) || usage.total_tokens !== input + output)) return null;
  for (const key of ["prompt_tokens_details", "input_tokens_details"]) {
    const details = usage[key];
    if (details === undefined || details === null) continue;
    if (typeof details !== "object" || Array.isArray(details)) return null;
    const cached = details.cached_tokens === undefined ? 0 : details.cached_tokens;
    if (!Number.isInteger(cached) || cached < 0 || cached > input) return null;
    if (details.audio_tokens !== undefined && details.audio_tokens !== 0) return null;
  }
  for (const key of ["completion_tokens_details", "output_tokens_details"]) {
    const details = usage[key];
    if (details === undefined || details === null) continue;
    if (typeof details !== "object" || Array.isArray(details)) return null;
    if (details.audio_tokens !== undefined && details.audio_tokens !== 0) return null;
  }
  // OpenAI bills the whole request at the long-context tier only when the
  // prompt itself passes the tier ceiling. Cached tokens count toward it.
  let tier = BUDGET_PIN;
  if (BUDGET_PIN.rate_tiers !== undefined) {
    tier = BUDGET_PIN.rate_tiers.find((item) => input <= item.max_input_tokens) || null;
    if (!tier) return null;
  }
