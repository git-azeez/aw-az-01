function frozenProviderPolicyError(policy) {
  if (!policy || typeof policy !== "object" || Array.isArray(policy)) return "malformed";
  const keys = Object.keys(policy).sort();
  if (keys.length === 2 && keys[0] === "allow_fallbacks" && keys[1] === "max_price") {
    if (policy.allow_fallbacks !== true) return "fallbacks";
    const priceProblem = frozenPriceError(policy.max_price);
    if (priceProblem) return priceProblem;
    if (policy.max_price.prompt !== 0.03 || policy.max_price.completion !== 0.8) return "max_price";
    return "";
