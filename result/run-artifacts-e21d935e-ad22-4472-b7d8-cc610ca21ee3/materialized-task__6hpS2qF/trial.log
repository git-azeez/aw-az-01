function normalizeMaiSseLine(line, toolCallStates) {
  const trimmed = line.endsWith("\r") ? line.slice(0, -1) : line;
  if (!trimmed.startsWith("data: ") || trimmed === "data: [DONE]") return line;
  let payload;
