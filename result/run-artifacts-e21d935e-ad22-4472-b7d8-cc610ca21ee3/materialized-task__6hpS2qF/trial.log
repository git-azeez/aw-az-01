function usageCount(usage, chat, responses) {
  const values = [chat, responses]
    .filter((key) => Object.prototype.hasOwnProperty.call(usage, key))
    .map((key) => usage[key]);
  if (!values.length || values.some((value) => !Number.isInteger(value) || value < 0)) return null;
  if (values.some((value) => value !== values[0])) return null;
  return values[0];
