function frozenPriceError(price) {
  if (!price || typeof price !== "object" || Array.isArray(price)) return "max_price";
  const priceKeys = Object.keys(price).sort();
  if (priceKeys.length !== 2 || priceKeys[0] !== "completion" || priceKeys[1] !== "prompt") return "max_price";
  for (const name of ["prompt", "completion"]) {
    const value = price[name];
    if (typeof value !== "number" || !Number.isFinite(value) || value < 0) return "max_price";
  }
  return "";
