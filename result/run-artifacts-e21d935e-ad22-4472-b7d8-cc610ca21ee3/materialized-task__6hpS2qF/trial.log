    const calls = choice && choice.delta && choice.delta.tool_calls;
    if (!Array.isArray(calls)) return;
    const choiceKey = Number.isInteger(choice.index) ? choice.index : choicePosition;
    let state = toolCallStates.get(choiceKey);
    if (!state) {
      state = { byId: new Map(), nextIndex: 0, lastIndex: null };
      toolCallStates.set(choiceKey, state);
    }
    calls.forEach((call, callPosition) => {
      if (!call) return;
      if (Number.isInteger(call.index)) {
        if (call.id) state.byId.set(call.id, call.index);
        state.nextIndex = Math.max(state.nextIndex, call.index + 1);
        state.lastIndex = call.index;
        return;
      }
      if (call && call.index === undefined) {
        let index;
        if (call.id && state.byId.has(call.id)) {
          index = state.byId.get(call.id);
        } else if (call.id) {
          index = state.nextIndex++;
          state.byId.set(call.id, index);
        } else if (calls.length > 1) {
          // Parallel-call argument chunks commonly retain array order but
          // omit both id and index. Reuse an established positional lane,
          // or allocate one when the first such chunk starts the stream.
          index = callPosition < state.nextIndex ? callPosition : state.nextIndex++;
        } else if (state.lastIndex !== null) {
          // A single id-less argument fragment continues the most recently
          // identified call in this choice.
          index = state.lastIndex;
        } else {
          index = state.nextIndex++;
        }
        call.index = index;
        state.lastIndex = index;
        changed = true;
      }
