  if (!Array.isArray(policy.order) || policy.order.length !== 1) return "multiple_upstreams";
  const upstream = policy.order[0];
  if (typeof upstream !== "string" || !FROZEN_PROVIDER_SLUG.test(upstream)) return "malformed";
